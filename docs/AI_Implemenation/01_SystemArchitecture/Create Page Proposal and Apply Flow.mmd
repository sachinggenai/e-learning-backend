%% Detailed Flow: Create Page Proposal and Apply Flow
graph TD
    subgraph "Phase -1: Edge Gateway and Async Job Wrapper"
        G1["POST /api/v1/ai/page-proposals<br/>IN: user_prompt, session_id, course_id, optional uploaded_file_id, selected_doc_excerpt"] --> G2["API Gateway Controls<br/>AuthN/AuthZ, rate limit, tenant isolation, idempotency"]
        G2 --> G3["AI Request Service"]
        G3 --> G4["Create Job Record<br/>status=PROCESSING, job_id, idempotency_key, trace_id"]
        G4 --> G5["Return 202 Accepted<br/>OUT: {job_id, status_url, ws_channel?}"]
        G4 --> G6["Enqueue Orchestration Task<br/>Queue: Kafka/Redis/SQS"]
        G5 --> G7["Frontend Polling / WebSocket updates"]
        G6 --> G8["AI Orchestrator Worker consumes job and restores trace context"]
    end

    subgraph "Phase 0: Intent, Source Content, and Retrieval"
        A0([Worker Resume Checkpoint Load<br/>Storage: Redis/DB checkpoint by job_id<br/>OUT: last_successful_phase + cached artifacts + checkpoint_version]) --> A0V{"Checkpoint version valid and lock acquired?"}
        A0V -- "No" --> A0R["Reload latest checkpoint and retry lock (optimistic concurrency)"]
        A0R --> A0V
        A0V -- "Yes" --> A1([Worker Hydrates Request Context<br/>IN: job_id, stored request payload, trace_id, total_llm_retries, checkpoint_version<br/>OUT: normalized_create_page_intent])
        A1 --> A2["Optional Source Extraction<br/>Tool/API: imports/analyze or internal extractor<br/>IN: uploaded PDF/DOCX chunk, headings, selected excerpt<br/>OUT: source_context {section_title, excerpt_text, learning_points, media_refs}"]
        A2 --> A4["List Existing Pages<br/>API: GET /api/v1/courses/{courseId}/pages<br/>OUT schema: PageDTO[] {pageId, title, order, layout, theme, pageCompletion, components}"]
        A4 --> A3["RAG Retrieval<br/>Storage: Vector DB / knowledge store<br/>IN: user_prompt, course topic, source_context, PageDTO[], current course goals<br/>OUT: rag_context[] {tone_examples, pedagogy_examples, similar page patterns}"]
        A4 --> A5["Get Candidate Templates<br/>API: GET /api/v1/courses/templates/available?category&search&sort_by<br/>OUT: TemplateOut[] {id, templateId, type, title, order, data}"]
        A5 --> A6["Build Planning Context for LLM<br/>IN: normalized_create_page_intent + source_context + rag_context[] + PageDTO[] + TemplateOut[]<br/>OUT: planning_payload_v1"]
    end

    G8 --> A0

    subgraph "Phase 1: AI Planning and Schema-Aware Generation"
        A6 --> L1["LLM Call 1 - Planner, low/medium params<br/>Goal: choose page purpose, title, template_type, insertion position<br/>IN: planning_payload_v1<br/>OUT: page_plan {title, template_type, rationale, target_order, required_fields, missing_info[]}"]
        L1 --> L1C["Atomic checkpoint write (CAS)<br/>Persist: planner output + loop counters + checkpoint_version++"]
        L1C --> L2
        
        L2{"Enough context to generate page data?"}
        L2 -- "No" --> L2A["Return clarification request<br/>OUT: clarification_payload {missing_info[], suggested_questions[]}<br/>Job state policy: NEEDS_CLARIFICATION can remain open indefinitely"]
        L2A --> L2B["Collect user clarification<br/>IN: clarification_answers"]
        L2B -- "Loop with preserved context" --> A6
        L2 -- "Yes" --> L3["Get Template Definition<br/>Source: template service / schema registry<br/>IN: template_type or templateId<br/>OUT: template_contract {FieldDefinition[], TemplateMetadata, preview hints, validation rules}"]
        L3 --> L4["Generation Payload Builder<br/>IN: user_prompt, source_context, rag_context[], page_plan, FieldDefinition[], TemplateMetadata<br/>OUT: generation_payload_v1"]
        L4 --> L4C["Atomic checkpoint write (CAS)<br/>Persist: generation payload fingerprint + checkpoint_version++"]
        L4C --> L5["LLM Call 2 - Generator, medium/high params<br/>Goal: produce schema-bound page data only<br/>IN: generation_payload_v1<br/>OUT: generated_page_candidate {title, template_type, customizations/data, optional assets, optional citations}"]
        L5 --> L6{"Valid JSON object?"}
        L6 -- "No" --> L6C{"repair_attempts < 3 AND total_llm_retries < 3?"}
        L6C -- "Yes" --> L6A["Loop 1 - JSON repair<br/>IN: parser_error + last_output + schema excerpt + repair_attempts + total_llm_retries<br/>OUT: corrected_generated_page_candidate"]
        L6A --> L5
        L6C -- "No" --> L6Fail["Fail fast<br/>OUT: 500 generation_failed {partial_output, parser_error, retryable=false, reason=retry_budget_exhausted}"]
        L6 -- "Yes" --> L7["Assemble proposal request payload<br/>OUT: propose_create_page_request {session_id, course_id, title, template_type, template_id?, data/customizations, page_order?, source_context?, rag_trace?}"]
    end

    subgraph "Phase 2: Proposal API and Validation Gate"
        L7 --> B0["Propose Create Page<br/>AI contract layer: propose_create_page(payload)<br/>Maps internally to template/page domain services"]
        B0 --> B1{"Session and course scope valid?<br/>IN: session_id, course_id"}
        B1 -- "No" --> B1_Err["OUT: 401/403 {code, message, remediation}"]
        B1 -- "Yes" --> B2{"Template resolvable?<br/>IN: template_type or template_id"}
        B2 -- "No" --> B2_Err["OUT: 400 {invalid_template, allowed_templates[]}"]
        B2 -- "Yes" --> B3["Schema Validation<br/>Against: FieldDefinition[] / template JSON schema<br/>IN: data/customizations<br/>OUT: ValidationResponse {valid, errors[], warnings[], suggestions[]}"]
        B3 -- "Fails" --> B3_Err["OUT: 422 HTTPValidationError + ValidationResponse<br/>errors identify exact field/path/rule mismatch"]
        B3_Err --> B3C{"schema_attempts < 3 AND total_llm_retries < 3?"}
        B3C -- "Yes" --> L4
        B3C -- "No" --> B3Fail["Fail validation pipeline<br/>OUT: 422/500 {reason=retry_budget_exhausted, last_validation_errors}"]
        B3 -- "Passes" --> B4["Business Rules Validation<br/>Checks: page order bounds, duplicates, required media, accessibility, SCORM/WCAG constraints<br/>OUT: business_rule_result {passed, warnings[], normalized_defaults}"]
        B4 --> B5["Persist Pending Proposal<br/>Storage: DB or Redis<br/>Record: proposal {proposal_id, status='pending', request_payload, normalized_payload, validation_result, preview_snapshot, proposal_expires_at}<br/>TTL: 30-60 min"]
        B5 --> B6["Generate Preview Payload<br/>Preview schema uses PreviewData {thumbnailUrl, previewType, previewImages, previewHtml, interactiveUrl}"]
        B6 -- "Preview service fails" --> B6F["Fallback preview<br/>OUT: PreviewData {previewType: 'text', previewHtml: safe_summary, thumbnailUrl: null}"]
        B6F --> B7
        B6 --> B7(["OUT to Frontend: create_page_proposal_response {proposal_id, preview: PreviewData, validation_status: ValidationResponse, summary, apply_requirements}"])
    end

    subgraph "Phase 3: Frontend Review, Feedback, and Looping"
        B7 --> F1["Render Proposal Review UI<br/>IN: proposal_id, PreviewData, ValidationResponse, summary"]
        F1 --> F2{"User decision"}
        F2 -- "Modify" --> F3["Collect feedback<br/>IN: user_edit_instruction, rejected_fields?, alternate_template?, selected_source_excerpt?<br/>OUT: revision_payload_v1"]
        F3 --> F3R{"Intent Router: Structural or Content Edit?"}
        F3R -- "Structural (template/order/scope)" --> L1
        F3R -- "Content-only (tone/text/media details)" --> L4
        F2 -- "Approve" --> F4["Apply request<br/>OUT: apply_page_proposal_request {proposal_id, user_confirmed: true, approved_by, approval_context_id, tenant_id, ui_context?}<br/>Exactly-once scope: tenant_id + approval_context_id + proposal_id"]
        F2 -- "Cancel" --> F5["OUT: proposal remains pending/cancelled"]
    end

    B7 --> G7

    subgraph "Phase 4: Apply Through Existing Domain Services"
        F4 --> E0["Apply Proposal API<br/>apply_page_proposal(proposal_id, user_confirmed=true)"]
        E0 --> E0Idem{"Apply idempotency check<br/>Key: tenant_id + approval_context_id + proposal_id"}
        E0Idem -- "Duplicate" --> E0IdemHit["Return prior success/error response (exactly-once within approval context)"]
        E0Idem -- "New" --> E0S{"Session still valid?"}
        E0S -- "No" --> E0S_Err["OUT: 401/403 {session_expired_or_revoked}"]
        E0S -- "Yes" --> E1{"Proposal exists AND status == pending AND now < proposal_expires_at?"}
        E1 -- "No" --> E1_Err["OUT: 400 {proposal_missing_or_expired}"]
        E1 -- "Yes" --> E1B["Proposal staleness check<br/>IN: course version/order snapshot, template availability<br/>OUT: stale_check {ok, conflicts[]}"]
        E1B -- "Stale" --> E1B_Err["OUT: 409 {proposal_stale, conflicts, suggested_reproposal=true}"]
        E1B -- "Fresh" --> E2{"Confirmed by user?"}
        E2 -- "No" --> E2_Err["OUT: 400 {user_confirmation_required}"]
        E2 -- "Yes" --> E3["Hydrate domain payload from proposal<br/>OUT: CreatePageFromTemplate {template_id, page_title, customizations, page_order}"]
        E3 --> E4["Reuse Existing API/Service Logic<br/>Internal service behind POST /api/v1/courses/{courseId}/pages/from-template"]
        E4 --> E4T["Open DB transaction boundary"]
        E4T --> E5["DB write via page service<br/>OUT schema: PageFromTemplateResponse {page: {id, course_id, title, order_index, layout, created_at, updated_at}, message}"]
        E5 --> E6["Optional reorder/update operations<br/>IN: created page id + target_order<br/>OUT: updated course hierarchy state"]
        E6 --> E4TC{"Transaction success?"}
        E4TC -- "No" --> E4TR["Rollback transaction<br/>OUT: 500 {apply_failed, rolled_back=true}"]
        E4TC -- "Yes" --> E7["Finalize proposal record<br/>Storage updates: proposal.status='applied', applied_at, trace metadata"]
        E7 --> E7A["Emit async audit event<br/>Queue/worker with retries, non-blocking for user response"]
        E7 --> E8(["OUT to Frontend: success_response {page, message, proposal_id, audit_ref?}"])
    end

    subgraph "Phase 5: Frontend State Finalization"
        E8 --> Z1["Update UI state<br/>IN: success_response<br/>OUT: local page list updated"]
        Z1 --> Z2["Optional fetch full page<br/>API: GET /api/v1/courses/{courseId}/pages/{pageId}<br/>OUT: PageDTO for editor hydration"]
        Z2 --> Z3(["Navigate to page editor<br/>IN: PageDTO or PageFromTemplateResponse.page"]) 
        E1B_Err --> Z4["Merge Required UI<br/>Show side-by-side: proposal vs current course state\nActions: manual resolve OR regenerate from latest"]
        Z4 --> Z5["On resolve: create deterministic merge patch artifact<br/>OUT: patch_artifact {base_version, target_version, operations[], checksum}"]
        Z5 --> Z6["Persist patch artifact for audit/replay<br/>Storage: audit metadata store"]
        Z6 --> F3R
    end