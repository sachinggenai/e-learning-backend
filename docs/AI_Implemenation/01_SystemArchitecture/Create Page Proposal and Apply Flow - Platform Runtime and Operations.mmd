%% Platform Runtime and Operations Flow: Create Page Proposal and Apply
graph TD
    subgraph "P0: Edge and Intake"
        P0A["POST /api/v1/ai/page-proposals"] --> P0B["API Gateway\nAuthN/AuthZ\nRate Limit\nTenant Isolation\nIdempotency"]
        P0B --> P0C["AI Request Service"]
        P0C --> P0D["Create Job\nstatus=PROCESSING\ntrace_id + idempotency_key\ntotal_llm_retries=0"]
        P0D --> P0E["Return 202\n{job_id, status_url, ws_channel?}"]
        P0D --> P0F["Publish orchestration task to Queue"]
    end

    subgraph "P1: Async Execution"
        P1A["Queue\nKafka / Redis / SQS"] --> P1A2{"delivery_attempts <= max_delivery_attempts?"}
        P1A2 -- "No" --> P1DLQ["Send to Dead Letter Queue\nEmit alert + incident runbook link"]
        P1A2 -- "Yes" --> P1B["AI Orchestrator Worker\nrestore trace context"]
        P1B --> P1B2["Load resume checkpoint from Redis/DB\nplanner output, pruned context, loop counters, checkpoint_version"]
        P1B2 --> P1B3{"checkpoint_version valid and lock acquired?"}
        P1B3 -- "No" --> P1B2
        P1B3 -- "Yes" --> P1C["Run Retrieval + Planning + Generation + Validation pipeline"]
        P1C --> P1CW["Atomic checkpoint write (CAS) after each phase\nversion++"]
        P1CW --> P1R{"total_llm_retries < 3?"}
        P1R -- "No" --> P1G
        P1R -- "Yes" --> P1D
        P1D{"Outcome"}
        P1D -- "NEEDS_CLARIFICATION" --> P1E["Update job status\nNEEDS_CLARIFICATION\nPolicy: may remain open indefinitely"]
        P1D -- "READY_FOR_REVIEW" --> P1F["Persist proposal\nstatus=PENDING\nTTL=30-60 min"]
        P1D -- "FAILED" --> P1G["Update job status\nFAILED + error contract"]
        P1G --> P1GR{"retryable and attempts remaining?"}
        P1GR -- "Yes" --> P1A
        P1GR -- "No" --> P1DLQ
    end

    P0F --> P1A

    subgraph "P2: Review and Apply Trigger"
        P2A["Frontend polls status endpoint or subscribes via WebSocket"] --> P2B{"User decision"}
        P2B -- "Modify" --> P2R{"Intent Router\nStructural vs Content"}
        P2R -- "Structural" --> P2C["Create structural revision task\nre-queue from planning"]
        P2R -- "Content-only" --> P2C2["Create content revision task\nre-queue from generation payload builder"]
        P2B -- "Approve" --> P2D["POST /api/v1/ai/page-proposals/{proposal_id}/apply\nincludes approval_context_id + tenant_id"]
        P2B -- "Cancel" --> P2E["Mark proposal CANCELLED or keep PENDING"]
    end

    P1E --> P2A
    P1F --> P2A
    P2C --> P1A
    P2C2 --> P1A

    subgraph "P3: Apply Guards"
        P2D --> P3I{"Apply idempotency scope\ntenant_id + approval_context_id + proposal_id"}
        P3I -- "Duplicate" --> P3I2["Return prior apply outcome"]
        P3I -- "New" --> P3A{"Session valid?"}
        P3A -- "No" --> P3E["401/403"]
        P3A -- "Yes" --> P3B{"Proposal exists + pending + not expired?"}
        P3B -- "No" --> P3F["400 missing_or_expired"]
        P3B -- "Yes" --> P3C["Staleness check\ncourse version\nhierarchy version\ntemplate version"]
        P3C --> P3D{"Stale?"}
        P3D -- "Yes" --> P3G["409 conflict + merge_required"]
        P3D -- "No" --> P3H["Hydrate domain payload"]
    end

    subgraph "P3b: Merge Required UX"
        P3G --> P3U1["Render side-by-side diff\nproposal vs current course state"]
        P3U1 --> P3U2{"Resolution action"}
        P3U2 -- "Manual merge" --> P3U3["Generate deterministic patch artifact\n{base_version, target_version, operations[], checksum}"]
        P3U3 --> P3U4["Persist patch artifact for audit/replay"]
        P3U4 --> P2R
        P3U2 -- "Regenerate from latest" --> P2C
    end

    subgraph "P4: Domain and Transaction Boundary"
        P3H --> P4A["Domain services\nTemplate Service + Page Service + Course Service"]
        P4A --> P4B["Begin transaction"]
        P4B --> P4C["Create page"]
        P4C --> P4D["Reorder/update hierarchy"]
        P4D --> P4E{"Commit success?"}
        P4E -- "No" --> P4F["Rollback\n500 apply_failed"]
        P4E -- "Yes" --> P4G["Set proposal APPLIED\napplied_at"]
    end

    subgraph "P5: Event Bus and Consumers"
        P4G --> P5A["Publish events\nProposalApplied\nPageCreated\nCourseUpdated"]
        P5A --> P5B["Event Bus\nKafka / SNS / RabbitMQ"]
        P5B --> P5C["Audit Service"]
        P5B --> P5D["Analytics Service"]
        P5B --> P5E["Search Indexer"]
        P5B --> P5F["Notification Service"]
        P5B --> P5G["Metrics Aggregator"]
    end

    subgraph "P6: Observability"
        O1["Prompt Version"]
        O2["Model Version"]
        O3["Token Usage"]
        O4["Latency"]
        O5["Cost"]
        O6["Trace Id"]
        O7["OpenTelemetry / Langfuse / LangSmith / Phoenix"]
    end

    P1C -.-> O7
    P1F -.-> O7
    P4G -.-> O7

    subgraph "P7: Governance"
        G1["Prompt Registry"]
        G2["Model Registry"]
        G3["Template Registry"]
        G4["Schema Registry"]
        G5["Audit Metadata Store"]
    end

    P1C -.-> G1
    P1C -.-> G2
    P4A -.-> G3
    P4A -.-> G4
    P5C -.-> G5

    subgraph "P8: Frontend Finalization"
        Z1["Update client cache"] --> Z2["Refresh page tree"]
        Z2 --> Z3["Fetch PageDTO"]
        Z3 --> Z4["Navigate to editor"]
    end

    P4G --> Z1
