+ */
+
+/* ═══════════════════════════════════════════════════════════════
+ * Preview Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.multiple-select-component {
+  width: 100%;
+  padding: 0;
+}
+
+.ms__question {
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 8px 0;
+  line-height: 1.5;
+}
+
+.ms__hint {
+  font-size: 14px;
+  color: var(--theme-text-secondary, #64748b);
+  margin: 0 0 16px 0;
+  font-style: italic;
+}
+
+.ms__options {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-bottom: 16px;
+}
+
+.ms__option {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 16px;
+  border: 2px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  background: var(--theme-background, #ffffff);
+  cursor: pointer;
+  transition: all 0.2s ease;
+  font-size: 15px;
+  color: var(--theme-text, #1e293b);
+}
+
+.ms__option:hover {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.04);
+}
+
+.ms__option input[type="checkbox"] {
+  width: 18px;
+  height: 18px;
+  flex-shrink: 0;
+  cursor: pointer;
+  accent-color: var(--theme-primary, #2563eb);
+}
+
+.ms__option input[type="checkbox"]:disabled {
+  cursor: not-allowed;
+}
+
+.ms__option--selected {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.08);
+}
+
+.ms__option--correct {
+  border-color: var(--theme-success, #22c55e);
+  background: rgba(34, 197, 94, 0.08);
+}
+
+.ms__option--incorrect {
+  border-color: var(--theme-error, #ef4444);
+  background: rgba(239, 68, 68, 0.08);
