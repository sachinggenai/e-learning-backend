+.tpl-sr-guide {
+  padding: 1.5rem;
+  background: var(--theme-surface, #fff);
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 12px;
+  max-width: 720px;
+}
+
+.tpl-sr-guide__title {
+  display: flex;
+  align-items: center;
+  gap: 0.625rem;
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 0.75rem;
+}
+
+.tpl-sr-guide__intro {
+  color: var(--theme-text-secondary, #64748b);
+  margin: 0 0 1.25rem;
+  font-size: 0.9375rem;
+}
+
+.tpl-sr-guide__empty { color: var(--theme-text-secondary, #64748b); font-style: italic; }
+
+/* Tool tabs */
+.tpl-sr-guide__tool-tabs {
+  display: flex;
+  gap: 0.5rem;
+  flex-wrap: wrap;
+  margin-bottom: 1.25rem;
+}
+
+.tpl-sr-guide__tool-tab {
