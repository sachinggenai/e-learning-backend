+/**
+ * AnimatedExplainer — Step-by-step animated content with visual storytelling.
+ * BEM Convention: .tpl-animated-explainer
+ * Category: media-rich
+ */
+
+/* ─── Preview Container ─────────────────────────────────────── */
+.tpl-animated-explainer {
+  width: 100%;
+}
+
+.tpl-animated-explainer__title {
+  margin: 0 0 16px 0;
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  line-height: 1.4;
+  text-align: center;
+}
+
+.tpl-animated-explainer__media {
+  width: 100%;
+  max-width: 600px;
+  margin: 0 auto 24px auto;
+  background: var(--theme-surface, #f8fafc);
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 12px;
+  padding: 32px;
+  text-align: center;
+  min-height: 250px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  position: relative;
+  overflow: hidden;
+}
+
+.tpl-animated-explainer__media-icon {
+  font-size: 64px;
+  margin-bottom: 16px;
+  animation: fadeInScale 0.5s ease-out;
+}
+
+.tpl-animated-explainer__media-text {
+  font-size: 18px;
+  font-weight: 500;
+  color: var(--theme-text, #1e293b);
+  margin: 0;
+  animation: fadeInUp 0.5s ease-out 0.2s both;
+}
+
+.tpl-animated-explainer__steps {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  margin-bottom: 16px;
+}
+
+.tpl-animated-explainer__step {
+  background: var(--theme-background, #ffffff);
+  border: 2px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  padding: 16px;
+  cursor: pointer;
+  transition: all 0.3s ease;
+  display: flex;
+  gap: 12px;
+  align-items: flex-start;
+}
+
+.tpl-animated-explainer__step:hover {
+  border-color: var(--theme-primary, #2563eb);
+  transform: translateX(4px);
+}
+
+.tpl-animated-explainer__step:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.tpl-animated-explainer__step--active {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.05);
+}
+
+.tpl-animated-explainer__step-number {
+  flex-shrink: 0;
+  width: 28px;
+  height: 28px;
+  border-radius: 50%;
+  background: var(--theme-primary, #2563eb);
+  color: #ffffff;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: 14px;
+  font-weight: 600;
+}
+
+.tpl-animated-explainer__step--active .tpl-animated-explainer__step-number {
+  animation: pulse 1.5s ease-in-out infinite;
+}
+
+.tpl-animated-explainer__step-content {
+  flex: 1;
+}
+
+.tpl-animated-explainer__step-title {
+  margin: 0 0 4px 0;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-animated-explainer__step-description {
+  margin: 0;
+  font-size: 13px;
+  color: var(--theme-text-secondary, #64748b);
+  line-height: 1.5;
+}
+
+.tpl-animated-explainer__controls {
+  display: flex;
+  gap: 12px;
+  justify-content: center;
+  margin-top: 16px;
+}
+
+.tpl-animated-explainer__control-btn {
+  padding: 10px 20px;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 6px;
+  background: var(--theme-background, #ffffff);
+  color: var(--theme-text, #1e293b);
+  font-size: 14px;
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  min-width: 100px;
+}
+
+.tpl-animated-explainer__control-btn:hover {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.05);
+  color: var(--theme-primary, #2563eb);
+}
+
+.tpl-animated-explainer__control-btn:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.tpl-animated-explainer__control-btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+  border-color: var(--theme-border, #e2e8f0);
+  background: var(--theme-surface, #f8fafc);
+  color: var(--theme-text-secondary, #64748b);
+}
+
+.tpl-animated-explainer__control-btn--primary {
+  background: var(--theme-primary, #2563eb);
+  color: #ffffff;
+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-animated-explainer__control-btn--primary:hover:not(:disabled) {
+  background: #1d4ed8;
+  border-color: #1d4ed8;
+}
+
+/* ─── Editor Container ─────────────────────────────────────── */
+.tpl-animated-explainer-editor {
+  width: 100%;
+}
+
+.tpl-animated-explainer-editor__field {
+  margin-bottom: 12px;
+}
+
+.tpl-animated-explainer-editor__label {
+  display: block;
+  font-size: 12px;
+  font-weight: 500;
+  margin-bottom: 4px;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-animated-explainer-editor__input {
+  width: 100%;
+  padding: 6px 8px;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 4px;
+  font-size: 13px;
+  color: var(--theme-text, #1e293b);
+  background: var(--theme-background, #ffffff);
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.tpl-animated-explainer-editor__input::placeholder {
+  color: var(--theme-text-secondary, #64748b);
+}
+
+.tpl-animated-explainer-editor__input:hover {
+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-animated-explainer-editor__input:focus {
+  outline: none;
+  border-color: var(--theme-primary, #2563eb);
+  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
+}
+
+.tpl-animated-explainer-editor__textarea {
+  width: 100%;
+  min-height: 60px;
+  padding: 6px 8px;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 4px;
+  font-size: 13px;
+  color: var(--theme-text, #1e293b);
+  background: var(--theme-background, #ffffff);
+  font-family: inherit;
+  resize: vertical;
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.tpl-animated-explainer-editor__textarea:hover {
+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-animated-explainer-editor__textarea:focus {
+  outline: none;
+  border-color: var(--theme-primary, #2563eb);
+  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
+}
+
+.tpl-animated-explainer-editor__step-card {
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 6px;
+  padding: 12px;
+  margin-bottom: 10px;
+  background: var(--theme-surface, #f8fafc);
+}
+
+.tpl-animated-explainer-editor__step-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 8px;
+}
+
+.tpl-animated-explainer-editor__step-title {
+  font-weight: 600;
+  font-size: 13px;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-animated-explainer-editor__remove-btn {
+  background: none;
+  border: none;
+  color: var(--theme-error, #ef4444);
+  font-size: 18px;
+  cursor: pointer;
+  padding: 0;
+  width: 24px;
+  height: 24px;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  border-radius: 4px;
+  transition: background-color 0.2s;
+}
+
+.tpl-animated-explainer-editor__remove-btn:hover {
+  background: rgba(239, 68, 68, 0.1);
+}
+
+.tpl-animated-explainer-editor__remove-btn:focus-visible {
+  outline: 2px solid var(--theme-error, #ef4444);
+  outline-offset: 2px;
+}
+
+.tpl-animated-explainer-editor__add-btn {
+  width: 100%;
+  padding: 10px;
+  border: 2px dashed var(--theme-border, #e2e8f0);
+  border-radius: 6px;
+  background: transparent;
+  color: var(--theme-primary, #2563eb);
+  font-weight: 500;
+  cursor: pointer;
+  transition: border-color 0.2s, background-color 0.2s;
+}
+
+.tpl-animated-explainer-editor__add-btn:hover {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.05);
+}
+
+.tpl-animated-explainer-editor__add-btn:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.tpl-animated-explainer-editor__small-label {
+  display: block;
+  font-size: 11px;
+  margin-bottom: 3px;
+  color: var(--theme-text, #1e293b);
+}
+
+/* ─── Animations ────────────────────────────────────────────── */
+@keyframes fadeInScale {
+  from {
+    opacity: 0;
+    transform: scale(0.8);
+  }
+  to {
+    opacity: 1;
+    transform: scale(1);
+  }
+}
+
+@keyframes fadeInUp {
+  from {
+    opacity: 0;
+    transform: translateY(20px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes pulse {
+  0%, 100% {
+    transform: scale(1);
+  }
+  50% {
+    transform: scale(1.1);
+  }
+}
+
+/* ─── Responsive Design ────────────────────────────────────── */
+@media (max-width: 768px) {
+  .tpl-animated-explainer__title {
+    font-size: 1.125rem;
+    margin-bottom: 14px;
+  }
+
+  .tpl-animated-explainer__media {
+    padding: 24px;
+    min-height: 200px;
+    margin-bottom: 20px;
+  }
+
+  .tpl-animated-explainer__media-icon {
+    font-size: 56px;
+  }
+
+  .tpl-animated-explainer__media-text {
+    font-size: 16px;
+  }
+
+  .tpl-animated-explainer__step {
+    padding: 14px;
+  }
+
+  .tpl-animated-explainer__controls {
+    flex-direction: column;
+  }
+
+  .tpl-animated-explainer__control-btn {
+    width: 100%;
+  }
+}
+
+@media (max-width: 375px) {
+  .tpl-animated-explainer__title {
+    font-size: 1rem;
+  }
+
+  .tpl-animated-explainer__media {
+    padding: 20px;
+    min-height: 180px;
+  }
+
+  .tpl-animated-explainer__media-icon {
+    font-size: 48px;
+  }
+
+  .tpl-animated-explainer__media-text {
+    font-size: 15px;
+  }
+
+  .tpl-animated-explainer__step {
+    padding: 12px;
+  }
+}
