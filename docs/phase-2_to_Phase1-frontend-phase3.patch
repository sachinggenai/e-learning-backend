+      responses:
+        "200":
+          description: Page with components
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/PageResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    patch:
+      tags: [Pages]
+      operationId: updatePage
+      summary: Update page metadata, layout, or theme
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/PageUpdateRequest"
+      responses:
+        "200":
+          description: Updated page
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/PageResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+    delete:
+      tags: [Pages]
+      operationId: deletePage
+      summary: Delete a page and its components
+      responses:
+        "204":
+          description: Page deleted
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  # ── Page Components ─────────────────────────
+  /courses/{courseId}/pages/{pageId}/components:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+      - $ref: "#/components/parameters/PageId"
+    get:
+      tags: [Components]
+      operationId: listPageComponents
