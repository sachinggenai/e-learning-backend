+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.tpl-decision-tree-editor__remove-btn:hover:not(:disabled) {
+  background: var(--theme-error, #dc2626);
+}
+
+.tpl-decision-tree-editor__remove-btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* ─── Responsive Design ────────────────────────────────────── */
+@media (max-width: 768px) {
+  .tpl-decision-tree {
+    gap: 12px;
+    padding: 12px;
+  }
+
+  .tpl-decision-tree__branches {
+    grid-template-columns: 1fr;
+  }
+
+  .tpl-decision-tree-editor {
+    gap: 12px;
+    padding: 12px;
+  }
+
+  .tpl-decision-tree-editor__option-card {
+    padding: 10px;
+  }
+}
