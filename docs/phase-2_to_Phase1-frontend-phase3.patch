+openapi: 3.1.0
+info:
+  title: eLearning Template Engine API
+  description: |
+    Backend API for the composable component-based eLearning authoring platform.
+    Supports 89+ component types, per-interaction audio, page completion tracking,
+    weighted scoring, full theming (layout + color system), and SCORM 1.2/2004 export.
+  version: 2.0.0
+  contact:
+    name: eLearning Platform Team
+
+servers:
+  - url: /api/v1
+    description: API v1 namespace
+
+tags:
+  - name: Health
+    description: System health check
+  - name: Courses
+    description: Course CRUD and management
+  - name: Pages
+    description: Page CRUD within a course
+  - name: Components
+    description: Component CRUD within a page
+  - name: ComponentRegistry
+    description: Component type definitions and categories
+  - name: Themes
+    description: Theme CRUD and design system
+  - name: Scoring
+    description: Scoring configuration and calculation
+  - name: Completion
+    description: Completion tracking and status
+  - name: Audio
+    description: Audio asset management and narration
+  - name: Export
+    description: SCORM package export
+  - name: Media
+    description: General media upload and management
+
+# ─────────────────────────────────────────────
+# PATHS
+# ─────────────────────────────────────────────
+paths:
+
+  # ── Health ──────────────────────────────────
+  /health:
+    get:
+      tags: [Health]
+      operationId: healthCheck
+      summary: Health check
+      responses:
+        "200":
+          description: Service is healthy
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/HealthCheckResponse"
+
+  # ── Courses ─────────────────────────────────
+  /courses:
+    get:
+      tags: [Courses]
+      operationId: listCourses
+      summary: List all courses
+      parameters:
+        - $ref: "#/components/parameters/PageParam"
+        - $ref: "#/components/parameters/LimitParam"
+        - name: status
+          in: query
+          schema:
+            type: string
+            enum: [draft, published, archived]
+      responses:
+        "200":
+          description: Paginated list of courses
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/CourseListResponse"
+    post:
+      tags: [Courses]
+      operationId: createCourse
+      summary: Create a course
+      description: |
+        Accepts both legacy `templates[]` format and new `pages[].components[]` format.
+        Legacy format is auto-converted to pages+components internally.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/CourseCreateRequest"
+      responses:
+        "201":
+          description: Course created
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/CourseResponse"
+        "409":
+          $ref: "#/components/responses/Conflict"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /courses/validate:
+    post:
+      tags: [Courses]
+      operationId: validateCourse
+      summary: Validate course data
+      description: Schema-driven validation via Component Type Registry
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/CourseValidationRequest"
+      responses:
+        "200":
+          description: Validation result
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ValidationResult"
+
+  /courses/{courseId}:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    get:
+      tags: [Courses]
+      operationId: getCourse
+      summary: Get a course by ID
+      responses:
+        "200":
+          description: Course with pages and components
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/CourseResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    patch:
+      tags: [Courses]
+      operationId: updateCourse
+      summary: Update course metadata
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/CourseUpdateRequest"
+      responses:
+        "200":
+          description: Updated course
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/CourseResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+    delete:
+      tags: [Courses]
+      operationId: deleteCourse
+      summary: Delete a course
+      responses:
+        "204":
+          description: Course deleted
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  # ── Pages ───────────────────────────────────
+  /courses/{courseId}/pages:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    get:
+      tags: [Pages]
+      operationId: listPages
+      summary: List all pages in a course (ordered)
+      responses:
+        "200":
+          description: Ordered list of pages
+          content:
+            application/json:
+              schema:
+                type: array
+                items:
+                  $ref: "#/components/schemas/PageResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    post:
+      tags: [Pages]
+      operationId: createPage
+      summary: Create a page (with optional components)
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/PageCreateRequest"
+      responses:
+        "201":
+          description: Page created
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/PageResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /courses/{courseId}/pages/reorder:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    post:
+      tags: [Pages]
+      operationId: reorderPages
