+
+  .tpl-text-media--left .tpl-text-media__media,
+  .tpl-text-media--left .tpl-text-media__text,
+  .tpl-text-media--right .tpl-text-media__media,
+  .tpl-text-media--right .tpl-text-media__text {
+    order: initial;
+  }
+
+  /* Ensure media doesn't overflow on mobile */
