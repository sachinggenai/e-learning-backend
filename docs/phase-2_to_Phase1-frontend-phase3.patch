+}
+
+.tpl-branching-scenario-editor__button--add-node {
+  width: 100%;
+  padding: 10px;
+  border: 2px dashed var(--theme-border, #e2e8f0);
+  background: transparent;
+  color: var(--theme-primary, #2563eb);
