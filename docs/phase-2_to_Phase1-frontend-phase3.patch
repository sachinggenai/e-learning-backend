+  border-radius: 50%;
+  animation: spin 1s linear infinite;
+}
+
+@keyframes spin {
+  to { transform: rotate(360deg); }
+}
+
+/* ─── FOCUS STATE (KEYBOARD NAVIGATION) ────────────────────────── */
+
+.button:focus-visible {
+  outline-color: var(--color-primary);
+}
+
+/* ─── RESPONSIVE ───────────────────────────────────────────────── */
+
+@media (max-width: 640px) {
+  .button {
+    width: 100%;
+  }
+}
