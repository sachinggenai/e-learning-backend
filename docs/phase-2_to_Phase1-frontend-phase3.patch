+        id: 'row1',
+        feature: 'Storage',
+        values: { col1: '10GB', col2: '100GB', col3: 'Unlimited' },
+      },
+      {
+        id: 'row2',
+        feature: 'Users',
+        values: { col1: '1', col2: '10', col3: 'Unlimited' },
