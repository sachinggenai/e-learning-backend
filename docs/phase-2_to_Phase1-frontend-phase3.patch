+components:
+  schemas:
+    # ══════════════════════════════════════════════════════════════════
+    # HEALTH
+    # ══════════════════════════════════════════════════════════════════
+
+    HealthCheckResponse:
+      type: object
+      properties:
+        status:
+          type: string
+          enum: [ok, unhealthy]
+        version:
+          type: string
+        timestamp:
+          type: string
+          format: date-time
+
+    # ══════════════════════════════════════════════════════════════════
+    # COURSES, PAGES, COMPONENTS (from existing spec)
+    # ══════════════════════════════════════════════════════════════════
+
+    CourseResponse:
+      type: object
+      properties:
+        courseId:
+          type: string
+        title:
+          type: string
+        author:
+          type: string
+        language:
+          type: string
+        description:
+          type: string
+          nullable: true
+        version:
+          type: string
+        status:
+          type: string
+          enum: [draft, published, archived]
+        pages:
+          type: array
+          items:
+            $ref: "#/components/schemas/PageResponse"
+        navigation:
+          $ref: "#/components/schemas/NavigationSettings"
+        settings:
+          $ref: "#/components/schemas/CourseSettings"
+        scoring:
+          $ref: "#/components/schemas/ScoringConfig"
+        createdAt:
+          type: string
+          format: date-time
+        updatedAt:
+          type: string
+          format: date-time
+
+    CourseCreateRequest:
+      type: object
+      required: [courseId, title, author]
+      properties:
+        courseId:
+          type: string
+          pattern: "^[a-zA-Z0-9_-]+$"
+          maxLength: 50
+        title:
+          type: string
+          maxLength: 200
+        author:
+          type: string
+          maxLength: 100
+        language:
+          type: string
+          default: en
+        description:
+          type: string
+          maxLength: 1000
+          nullable: true
+        version:
+          type: string
+          default: "1.0.0"
+        pages:
+          type: array
+          items:
+            $ref: "#/components/schemas/PageCreateRequest"
+        navigation:
+          $ref: "#/components/schemas/NavigationSettings"
+        settings:
+          $ref: "#/components/schemas/CourseSettings"
+        scoring:
+          $ref: "#/components/schemas/ScoringConfig"
+
+    CourseUpdateRequest:
+      type: object
+      properties:
+        title:
+          type: string
+          maxLength: 200
+        author:
+          type: string
+          maxLength: 100
+        language:
+          type: string
+        description:
+          type: string
+          maxLength: 1000
+          nullable: true
+        version:
+          type: string
+        navigation:
+          $ref: "#/components/schemas/NavigationSettings"
+        settings:
+          $ref: "#/components/schemas/CourseSettings"
+        scoring:
+          $ref: "#/components/schemas/ScoringConfig"
+        status:
+          type: string
+          enum: [draft, published, archived]
+
+    CourseListResponse:
+      type: object
+      properties:
+        items:
+          type: array
+          items:
+            type: object
+            properties:
+              courseId:
+                type: string
+              title:
+                type: string
+              author:
+                type: string
+              status:
+                type: string
+              pageCount:
+                type: integer
+              createdAt:
+                type: string
+                format: date-time
+              updatedAt:
+                type: string
+                format: date-time
+        total:
+          type: integer
+        page:
+          type: integer
+        limit:
+          type: integer
+
+    CourseValidationRequest:
+      type: object
+      required: [course]
+      properties:
+        course:
+          type: object
+
+    NavigationSettings:
+      type: object
+      properties:
+        allowSkip:
+          type: boolean
+          default: true
+        showProgress:
+          type: boolean
+          default: true
+        linearProgression:
+          type: boolean
+          default: false
+
+    CourseSettings:
+      type: object
+      properties:
+        themeId:
+          type: string
+          format: uuid
+          nullable: true
+        autoplay:
+          type: boolean
+          default: false
+        duration:
+          type: number
+          nullable: true
+
+    PageCreateRequest:
+      type: object
+      required: [title]
+      properties:
+        title:
+          type: string
+          maxLength: 200
+        components:
+          type: array
+          items:
+            $ref: "#/components/schemas/ComponentCreateRequest"
+        pageCompletion:
+          type: object
+        layout:
+          type: object
+        theme:
+          type: object
+
+    PageUpdateRequest:
+      type: object
+      properties:
+        title:
+          type: string
+          maxLength: 200
+        pageCompletion:
+          type: object
+        layout:
+          type: object
+        theme:
+          type: object
+
+    PageResponse:
+      type: object
+      properties:
+        pageId:
+          type: string
+        title:
+          type: string
+        order:
+          type: integer
+        components:
+          type: array
+          items:
+            $ref: "#/components/schemas/ComponentResponse"
+        pageCompletion:
+          type: object
+        layout:
+          type: object
+        theme:
+          type: object
+        createdAt:
+          type: string
+          format: date-time
+        updatedAt:
+          type: string
+          format: date-time
+
+    ComponentCreateRequest:
+      type: object
+      required: [componentType]
+      properties:
+        componentType:
+          type: string
+        data:
+          type: object
+          default: {}
+        audioConfig:
+          type: object
+        completionCriteria:
+          type: object
+        styling:
+          type: object
+
+    ComponentUpdateRequest:
+      type: object
+      properties:
+        data:
+          type: object
+        audioConfig:
+          type: object
+        completionCriteria:
+          type: object
+        styling:
+          type: object
+
+    ComponentResponse:
