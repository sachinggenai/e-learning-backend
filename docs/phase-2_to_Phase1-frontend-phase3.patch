+/**
+ * Infographic — Visual data presentation with sections.
+ * BEM Convention: .tpl-infographic
+ * Category: media-rich
+ */
+
+/* ─── Preview Container ─────────────────────────────────────── */
+.tpl-infographic {
+  width: 100%;
+}
+
+.tpl-infographic__title {
+  text-align: center;
