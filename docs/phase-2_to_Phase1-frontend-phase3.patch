+}
+
+.tpl-decision-tree-editor__textarea {
+  resize: vertical;
+  min-height: 80px;
+}
+
+.tpl-decision-tree-editor__input:hover:not(:disabled),
+.tpl-decision-tree-editor__textarea:hover:not(:disabled) {
