+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-btn--primary:hover {
+  background: #1d4ed8;
+}
+
+.tpl-btn--danger {
+  color: #dc2626;
+  border-color: #fca5a5;
+}
+
+.tpl-btn--danger:hover {
+  background: #fef2f2;
+}
+
+.tpl-btn--sm {
+  padding: 4px 8px;
+  font-size: 12px;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ *  Welcome
+ * ═══════════════════════════════════════════════════════════════ */
+
+.tpl-welcome-preview {
