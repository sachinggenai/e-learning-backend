@@ -0,0 +1,77 @@
+.tpl-dos-and-donts {
+  display: grid;
+  gap: 14px;
+}
+
+.tpl-dos-and-donts--columns {
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+}
+
+.tpl-dos-and-donts--stacked {
+  grid-template-columns: 1fr;
+}
+
+.tpl-dos-and-donts__title {
+  margin: 0;
+  grid-column: 1 / -1;
+}
+
+.tpl-dos-and-donts__section {
+  border: 1px solid var(--theme-border);
+  border-radius: 12px;
+  background: var(--theme-surface);
+  color: var(--theme-text);
+  padding: 12px;
+}
+
+.tpl-dos-and-donts__section-title {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.tpl-dos-and-donts__section ul {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: grid;
+  gap: 8px;
+}
+
+.tpl-dos-and-donts__item {
+  border: 1px solid var(--theme-border);
+  border-radius: 8px;
+  padding: 8px;
+}
+
+.tpl-dos-and-donts__empty {
+  color: var(--theme-text-secondary);
+}
+
+.tpl-dos-and-donts__details {
+  color: var(--theme-text-secondary);
+  margin-top: 6px;
+}
+
+.tpl-dos-and-donts-editor {
+  display: grid;
+  gap: 10px;
+}
+
+.tpl-dos-and-donts-editor label,
+.tpl-dos-and-donts-editor__row {
+  display: grid;
+  gap: 6px;
+}
+
+.tpl-dos-and-donts-editor__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+
+@media (max-width: 840px) {
+  .tpl-dos-and-donts--columns {
+    grid-template-columns: 1fr;
+  }
+}
