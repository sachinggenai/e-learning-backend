+/**
+ * Matching - Assessment Template Styles
+ * BEM Convention: .tpl-matching / .tpl-matching-editor
+ */
+
+/* ═══════════════════════════════════════════════════════════════
+ * Preview Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.matching-component {
+  width: 100%;
+  padding: 0;
+}
+
+.matching-component h3 {
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 20px 0;
+  line-height: 1.5;
+}
+
+.matching__columns {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 20px;
+  margin-bottom: 20px;
+}
+
+.matching__left,
+.matching__right {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.matching__item {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 12px 16px;
+  border: 2px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  background: var(--theme-background, #ffffff);
+  font-size: 14px;
+  color: var(--theme-text, #1e293b);
+  text-align: left;
+  cursor: pointer;
+  transition: all 0.2s ease;
+  line-height: 1.5;
+}
+
+.matching__item:hover:not(:disabled) {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.04);
+  transform: translateX(2px);
+}
+
+.matching__item:focus {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.matching__item--selected {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.1);
+  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
+}
+
+.matching__item--matched {
+  border-color: #86efac;
+  background: rgba(34, 197, 94, 0.08);
+  cursor: default;
+  transform: none;
+}
+
+.matching__item--correct {
+  border-color: var(--theme-success, #22c55e);
+  background: rgba(34, 197, 94, 0.1);
+  color: #166534;
+}
+
+.matching__item--incorrect {
+  border-color: var(--theme-error, #ef4444);
+  background: rgba(239, 68, 68, 0.1);
+  color: #991b1b;
+}
+
+.matching__item:disabled {
+  cursor: not-allowed;
+  opacity: 0.9;
+}
+
+.matching__linked {
+  margin-left: 8px;
+  font-weight: 700;
+  color: var(--theme-primary, #2563eb);
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Editor Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.matching-editor {
+  width: 100%;
+}
+
+.matching-editor__pair-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 10px;
+}
+
+.matching-editor__pair-row input {
+  flex: 1;
+  min-width: 0;
+}
+
+.matching-editor__arrow {
+  flex-shrink: 0;
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--theme-text-secondary, #64748b);
+  user-select: none;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Responsive Design
+ * ═══════════════════════════════════════════════════════════════ */
+
+@media (max-width: 768px) {
+  .matching-component h3 {
+    font-size: 15px;
+  }
+
+  .matching__columns {
+    grid-template-columns: 1fr;
+    gap: 16px;
+  }
+
+  .matching__item {
+    padding: 10px 14px;
+    font-size: 13px;
+  }
+
+  .matching__item:hover:not(:disabled) {
+    transform: none;
+  }
+
+  .matching-editor__pair-row {
+    flex-wrap: wrap;
+  }
+
+  .matching-editor__pair-row input {
+    flex-basis: 100%;
+  }
+
+  .matching-editor__arrow {
+    order: 1;
+    transform: rotate(90deg);
+  }
+}
