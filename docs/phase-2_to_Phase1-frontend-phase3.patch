+
+/* Troubleshooting */
+.tpl-sr-guide__troubleshoot { margin-top: 1rem; }
+.tpl-sr-guide__troubleshoot h3 { font-size: 1rem; margin: 0 0 0.75rem; }
+
+.tpl-sr-guide__issue { border: 1px solid var(--theme-border, #e2e8f0); border-radius: 6px; margin-bottom: 0.5rem; }
+.tpl-sr-guide__issue-toggle {
+  width: 100%;
+  text-align: left;
+  background: none;
+  border: none;
+  padding: 0.75rem 1rem;
+  font-size: 0.9375rem;
+  font-weight: 500;
+  color: var(--theme-text, #1e293b);
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+}
+.tpl-sr-guide__issue-toggle:hover { background: var(--theme-border, #e2e8f0); }
+.tpl-sr-guide__issue-toggle:focus-visible { outline: 2px solid var(--theme-primary, #6366f1); outline-offset: 2px; }
+.tpl-sr-guide__issue-fix {
+  padding: 0.75rem 1rem;
+  color: var(--theme-text-secondary, #64748b);
+  font-size: 0.875rem;
+  margin: 0;
+  border-top: 1px solid var(--theme-border, #e2e8f0);
+}
+
+/* Editor */
+.tpl-sr-guide-editor { display: flex; flex-direction: column; gap: 0.75rem; }
+.tpl-sr-guide-editor label {
+  display: flex; flex-direction: column; gap: 0.25rem;
+  font-size: 0.875rem; font-weight: 500; color: var(--theme-text, #1e293b);
+}
+.tpl-sr-guide-editor input,
+.tpl-sr-guide-editor textarea {
+  padding: 0.5rem; border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 6px; font-size: 0.875rem; background: var(--theme-surface, #fff);
+  color: var(--theme-text, #1e293b);
+}
+.tpl-sr-guide-editor__head { display: flex; align-items: center; justify-content: space-between; margin-top: 0.5rem; }
+.tpl-sr-guide-editor__head h3 { margin: 0; font-size: 0.9375rem; }
+.tpl-sr-guide-editor__num {
+  display: inline-flex; align-items: center; justify-content: center;
+  width: 24px; height: 24px; border-radius: 50%;
+  background: var(--theme-primary, #6366f1); color: #fff;
+  font-size: 0.75rem; font-weight: 700; flex-shrink: 0;
+}
+.tpl-sr-guide-editor__row { display: grid; grid-template-columns: auto 1fr 1fr 1fr auto; gap: 0.5rem; align-items: center; }
