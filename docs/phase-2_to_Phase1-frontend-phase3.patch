+  .tpl-flip-cards__card-back {
+    padding: 16px;
+    font-size: 14px;
+  }
+
+  .tpl-flip-cards-editor {
+    gap: 12px;
+    padding: 12px;
+  }
+
+  .tpl-flip-cards-editor__card-item {
+    padding: 10px;
+  }
+}
