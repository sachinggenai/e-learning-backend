+  cursor: pointer;
+  border-radius: 6px;
+}
+
+.tpl-branching-scenario-editor__button--add-choice {
+  padding: 6px 12px;
+  border: 1px dashed var(--theme-border, #e2e8f0);
+  background: transparent;
