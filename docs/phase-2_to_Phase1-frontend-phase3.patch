+
+.audio-player__play-btn:hover:not(:disabled) {
+  background: var(--color-primary-dark, #357abd);
+}
+
+.audio-player__play-btn:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* Time display */
+.audio-player__time {
