+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ThemeResponse"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /themes/presets:
+    get:
+      tags: [Themes]
+      operationId: listPresetThemes
+      summary: List built-in preset themes
+      responses:
+        "200":
+          description: Preset themes
+          content:
+            application/json:
+              schema:
+                type: array
+                items:
+                  $ref: "#/components/schemas/ThemeResponse"
+
+  /themes/{themeId}:
+    parameters:
+      - $ref: "#/components/parameters/ThemeId"
+    get:
+      tags: [Themes]
+      operationId: getTheme
+      summary: Get theme details
+      responses:
+        "200":
+          description: Theme detail
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ThemeResponse"
