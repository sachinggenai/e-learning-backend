+}
+.tpl-sr-guide__step--done .tpl-sr-guide__step-num { background: #10b981; }
+
+.tpl-sr-guide__step-text {
+  flex: 1;
+  font-size: 0.9375rem;
+  color: var(--theme-text, #1e293b);
+  margin: 0;
+  padding-top: 3px;
+}
+
+.tpl-sr-guide__step-check {
+  padding: 4px 12px;
+  border: 1px solid var(--theme-primary, #6366f1);
+  border-radius: 6px;
+  background: none;
+  color: var(--theme-primary, #6366f1);
+  font-size: 0.8125rem;
+  font-weight: 600;
+  cursor: pointer;
+  flex-shrink: 0;
+}
+.tpl-sr-guide__step-check:disabled { color: #10b981; border-color: #10b981; cursor: default; }
+.tpl-sr-guide__step-check:not(:disabled):hover { background: var(--theme-primary, #6366f1); color: #fff; }
+.tpl-sr-guide__step-check:focus-visible { outline: 2px solid var(--theme-primary, #6366f1); outline-offset: 2px; }
+
+.tpl-sr-guide__step-expected {
+  font-size: 0.8125rem;
+  color: var(--theme-text-secondary, #64748b);
+  margin: 0.5rem 0 0 40px;
+  font-style: italic;
+}
+.tpl-sr-guide__step-notes {
+  font-size: 0.8125rem;
+  color: var(--theme-info, #0ea5e9);
+  margin: 0.5rem 0 0 40px;
+}
+
+/* Complete button */
+.tpl-sr-guide__complete-btn {
+  padding: 10px 24px;
+  background: #10b981;
+  color: #fff;
+  border: none;
+  border-radius: 8px;
+  font-size: 0.9375rem;
+  font-weight: 600;
+  cursor: pointer;
