+/* ─── FlipCards Component Styles ──────────────────────────────
+   BEM naming + theme tokens for Flip Cards template
+   ──────────────────────────────────────────────────────────────── */
+
+/* ─── Main Container ──────────────────────────────────────────── */
+.tpl-flip-cards {
+  display: flex;
+  flex-direction: column;
+  gap: 16px;
+  width: 100%;
+  padding: 0;
+}
+
+.tpl-flip-cards__title {
+  margin: 0;
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  line-height: 1.4;
+}
+
+/* ─── Grid Layout ─────────────────────────────────────────────── */
+.tpl-flip-cards__grid {
+  display: grid;
+  gap: 16px;
+  width: 100%;
+}
+
+/* ─── Individual Card Container ───────────────────────────────── */
+.tpl-flip-cards__card {
+  perspective: 1000px;
+  cursor: pointer;
+  outline: none;
+  position: relative;
+  transition: box-shadow 150ms ease;
+}
+
+.tpl-flip-cards__card:hover {
+  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
+}
+
+.tpl-flip-cards__card:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+  border-radius: 8px;
+}
+
+/* ─── Card Flip Animation ─────────────────────────────────────── */
+.tpl-flip-cards__card-inner {
+  position: relative;
+  width: 100%;
+  min-height: 180px;
