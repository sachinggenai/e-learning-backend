+}
+
+.tpl-infographic__section:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.tpl-infographic__icon {
+  font-size: 36px;
+  margin-bottom: 8px;
+}
+
+.tpl-infographic__stat-value {
+  font-size: 32px;
+  font-weight: 700;
+  color: var(--theme-primary, #2563eb);
+  line-height: 1.2;
+}
