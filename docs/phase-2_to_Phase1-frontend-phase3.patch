+/**
+ * Template Component Styles
+ *
+ * Shared stylesheet for all content & assessment template editors and previews.
+ * Scoped via BEM-style class names with `tpl-` prefix.
+ */
+
+/* ═══════════════════════════════════════════════════════════════
+ *  Shared / Common
+ * ═══════════════════════════════════════════════════════════════ */
+
+.tpl-editor,
+.tpl-preview {
+  width: 100%;
+  font-size: var(--theme-font-size-base, 16px);
+  font-family: var(--theme-font-family, 'Inter', system-ui, sans-serif);
+  color: var(--theme-text, #1e293b);
+  line-height: 1.6;
+}
+
+/* ── Field groups ──────────────────────────────────────────────── */
+.tpl-field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  margin-bottom: 14px;
+}
+
+.tpl-field__label {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--theme-text-secondary, #64748b);
+}
+
+.tpl-field__input,
+.tpl-field__textarea {
+  width: 100%;
+  padding: 8px 12px;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 6px;
+  font-size: 14px;
+  font-family: inherit;
+  color: var(--theme-text, #1e293b);
+  background: var(--theme-background, #fff);
+  transition: border-color 0.15s, box-shadow 0.15s;
+  box-sizing: border-box;
+}
+
+.tpl-field__input:focus,
+.tpl-field__textarea:focus {
+  outline: none;
+  border-color: var(--theme-primary, #2563eb);
+  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
+}
+
+.tpl-field__textarea {
+  resize: vertical;
+  min-height: 80px;
+}
+
+/* ── Action buttons (in editors) ───────────────────────────────── */
+.tpl-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 4px;
+  padding: 6px 14px;
+  border: 1px solid var(--theme-border, #cbd5e1);
+  border-radius: 6px;
+  background: var(--theme-background, #fff);
+  color: var(--theme-text, #1e293b);
+  font-size: 13px;
+  font-weight: 500;
+  cursor: pointer;
+  transition: background 0.12s, border-color 0.12s;
