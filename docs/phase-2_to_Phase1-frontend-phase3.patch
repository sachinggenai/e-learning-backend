+/**
+ * TrueFalse - Assessment Template Styles
+ * BEM Convention: .tpl-tf / .tpl-tf-editor
+ */
+
+/* ═══════════════════════════════════════════════════════════════
+ * Preview Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.tf-component {
+  width: 100%;
+  padding: 0;
+}
+
+.tf__question {
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 20px 0;
+  line-height: 1.6;
+  text-align: center;
+  padding: 16px;
+  background: var(--theme-surface, #f8fafc);
+  border-radius: 8px;
+}
+
+.tf__options {
+  display: flex;
+  gap: 12px;
+  justify-content: center;
+  margin-bottom: 16px;
+  flex-wrap: wrap;
+}
+
+.tf__option {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  padding: 12px 32px;
+  min-width: 120px;
+  border: 2px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  background: var(--theme-background, #ffffff);
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+
+.tf__option:hover:not(:disabled) {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.04);
+  transform: translateY(-1px);
+}
+
+.tf__option:focus {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.tf__option--selected {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.1);
+  color: var(--theme-primary, #2563eb);
+}
+
+.tf__option--correct {
+  border-color: var(--theme-success, #22c55e);
+  background: rgba(34, 197, 94, 0.1);
+  color: #166534;
+}
+
+.tf__option--incorrect {
+  border-color: var(--theme-error, #ef4444);
+  background: rgba(239, 68, 68, 0.1);
+  color: #991b1b;
+}
+
+.tf__option:disabled {
+  cursor: not-allowed;
+}
+
+.tf__option svg {
+  flex-shrink: 0;
+}
+
+.tf__explanation {
+  margin-top: 16px;
+  padding: 12px 16px;
+  background: var(--theme-surface, #f8fafc);
+  border-left: 4px solid var(--theme-info, #3b82f6);
+  border-radius: 4px;
+  font-size: 14px;
+  color: var(--theme-text, #1e293b);
+  line-height: 1.6;
+}
+
+.tf__explanation strong {
+  color: var(--theme-text, #1e293b);
+  font-weight: 600;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Editor Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.tf-editor {
+  width: 100%;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Responsive Design
+ * ═══════════════════════════════════════════════════════════════ */
+
+@media (max-width: 768px) {
+  .tf__question {
+    font-size: 15px;
+    padding: 14px;
+  }
+
+  .tf__options {
+    flex-direction: column;
+    align-items: stretch;
+  }
+
+  .tf__option {
+    width: 100%;
+    min-width: auto;
+    padding: 12px 24px;
+  }
+}
