+  transition: border-color 0.15s;
+}
+.tpl-sr-guide__step--done {
+  border-color: #10b981;
+  background: #f0fdf4;
+}
+
+.tpl-sr-guide__step-header {
+  display: flex;
+  align-items: flex-start;
+  gap: 0.75rem;
+}
+
+.tpl-sr-guide__step-num {
+  width: 28px;
+  height: 28px;
