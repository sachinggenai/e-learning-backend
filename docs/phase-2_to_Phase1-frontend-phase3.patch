+  it('allows changing node type via dropdown', () => {
+    const onChange = jest.fn();
+    const data = {
+      title: 'Flow',
+      nodes: [{ id: 'n1', type: 'start' as const, label: 'Start' }],
+      connections: [],
+    };
+    const { container } = render(
+      <FlowchartEditor
