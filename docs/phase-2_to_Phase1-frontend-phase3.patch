+    
+    // Should show save success toast
+    await waitFor(() => {
+      expect(screen.getByText(/saved|success/i)).toBeInTheDocument();
+    });
+    
+    // Validate
+    const validateButton = await screen.findByRole('button', { name: /validate/i });
+    await user.click(validateButton);
+    
