+/* ============================================================
+   Component Settings — Wix Dark Side Panel
+   ============================================================ */
+
+.component-settings {
+  position: absolute;
+  top: 0;
+  right: 0;
+  width: 100%;
+  height: 100%;
+  background: var(--sidebar-bg);
+  border-left: 1px solid var(--sidebar-border);
+  display: flex;
+  flex-direction: column;
+  z-index: var(--z-overlay, 500);
+  box-shadow: -4px 0 20px rgba(0, 0, 0, 0.25);
+  font-family: var(--font-sans, system-ui, sans-serif);
+  color: var(--sidebar-text);
+}
+
+/* ─── Header ──────────────────────────────────────────────── */
+.cs-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 20px;
+  border-bottom: 1px solid var(--sidebar-border);
+}
+.cs-header h3 {
+  margin: 0;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--sidebar-text-bright);
+}
+.cs-close {
+  background: none;
+  border: none;
+  font-size: 22px;
+  cursor: pointer;
+  color: var(--sidebar-text-muted);
+  padding: 0 4px;
+  transition: color 0.15s;
+}
+.cs-close:hover { color: var(--sidebar-text-bright); }
+
+/* ─── Tabs ────────────────────────────────────────────────── */
+.cs-tabs {
+  display: flex;
+  border-bottom: 1px solid var(--sidebar-border);
+}
+.cs-tab {
+  flex: 1;
+  padding: 10px 0;
+  background: none;
+  border: none;
+  border-bottom: 2px solid transparent;
+  font-size: 13px;
+  font-weight: 500;
+  cursor: pointer;
+  color: var(--sidebar-text-muted);
+  transition: color 0.2s, border-color 0.2s;
+}
+.cs-tab:hover { color: var(--sidebar-text-bright); }
+.cs-tab--active {
+  color: var(--sidebar-accent);
+  border-bottom-color: var(--sidebar-accent);
+}
+
+/* ─── Body ────────────────────────────────────────────────── */
+.cs-body {
+  flex: 1;
+  overflow-y: auto;
+  padding: 20px;
+}
+
+/* ─── Sections ────────────────────────────────────────────── */
+.cs-section h4 {
+  margin: 0 0 16px;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--sidebar-text-bright);
+  text-transform: uppercase;
+  letter-spacing: 0.3px;
+}
+
+.cs-field {
+  margin-bottom: 16px;
+}
+.cs-field label {
+  display: block;
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--sidebar-text-muted);
+  margin-bottom: 4px;
+}
+.cs-field input[type="text"],
+.cs-field input[type="number"],
+.cs-field select {
+  width: 100%;
+  padding: 8px 10px;
+  border: 1px solid var(--sidebar-border);
+  border-radius: var(--radius-md, 4px);
+  font-size: 13px;
+  background: var(--sidebar-section-bg);
+  color: var(--sidebar-text-bright);
+  transition: border-color 0.15s, box-shadow 0.15s;
+}
+.cs-field input[type="text"]:focus,
+.cs-field input[type="number"]:focus,
+.cs-field select:focus {
+  outline: none;
+  border-color: var(--sidebar-accent);
+  box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.15);
+}
+.cs-field input[type="color"] {
+  width: 48px;
+  height: 32px;
+  padding: 2px;
+  border: 1px solid var(--sidebar-border);
+  border-radius: var(--radius-md, 4px);
+  cursor: pointer;
+  background: var(--sidebar-section-bg);
+}
+.cs-field small {
+  display: block;
+  margin-top: 4px;
+  font-size: 11px;
+  color: var(--sidebar-text-muted);
+}
+
+/* Toggle checkboxes */
+.cs-toggle label {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  cursor: pointer;
+  font-size: 13px;
+  font-weight: 400;
+  color: var(--sidebar-text);
+}
+.cs-toggle input[type="checkbox"] {
+  width: 16px;
+  height: 16px;
+  accent-color: var(--sidebar-accent);
+}
+
+.cs-info {
+  font-size: 13px;
+  color: var(--sidebar-text-muted);
+  font-style: italic;
+}
+
+/* ─── Audio Item ──────────────────────────────────────────── */
+.cs-audio-items {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+.cs-audio-item {
+  background: var(--sidebar-section-bg);
+  border: 1px solid var(--sidebar-border);
+  border-radius: var(--radius-md, 6px);
+  padding: 12px;
+}
+.cs-audio-item-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 8px;
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--sidebar-text-muted);
+}
+.cs-remove {
+  background: none;
+  border: none;
+  cursor: pointer;
+  font-size: 18px;
+  color: rgba(248, 113, 113, 0.8);
+  padding: 0 4px;
+  transition: color 0.15s;
+}
+.cs-remove:hover { color: #f87171; }
+
+/* ─── Footer ──────────────────────────────────────────────── */
+.cs-footer {
+  display: flex;
+  gap: 8px;
+  padding: 14px 20px;
+  border-top: 1px solid var(--sidebar-border);
+  justify-content: flex-end;
+}
+
+/* ─── Buttons ─────────────────────────────────────────────── */
+.cs-btn {
+  padding: 8px 16px;
+  border-radius: var(--radius-md, 4px);
+  font-size: 13px;
+  font-weight: 500;
+  cursor: pointer;
+  border: none;
+  transition: background 0.2s, filter 0.2s;
+}
+.cs-btn-primary {
+  background: var(--sidebar-accent);
+  color: #fff;
+}
+.cs-btn-primary:hover { filter: brightness(0.9); }
+.cs-btn-secondary {
+  background: var(--sidebar-section-bg);
+  color: var(--sidebar-text);
+  border: 1px solid var(--sidebar-border);
+}
+.cs-btn-secondary:hover { background: var(--sidebar-bg-hover); }
+
+/* ─── Responsive ──────────────────────────────────────────── */
+@media (max-width: 768px) {
+  .component-settings {
+    width: 100%;
+  }
+}
