+.tpl-step-by-step {
+  display: flex;
+  flex-direction: column;
+  gap: 20px;
+}
+
+.tpl-step-by-step__title {
+  margin: 0;
+  font-size: 18px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+}
+
+/* Progress indicators (step circles) */
+.tpl-step-by-step__progress {
+  display: flex;
+  align-items: center;
+  gap: 4px;
+}
+
+.tpl-step-by-step__step-button {
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  border: none;
+  font-weight: 600;
+  font-size: 13px;
+  cursor: pointer;
+  transition: all 200ms ease;
+}
+
+/* Active step (current) */
+.tpl-step-by-step__step-button--active {
+  background: var(--theme-primary, #2563eb);
+  color: #fff;
+}
+
+/* Visited step */
+.tpl-step-by-step__step-button--visited {
+  background: var(--theme-info, #3b82f6);
+  color: var(--theme-primary, #2563eb);
+}
+
+/* Unvisited step */
+.tpl-step-by-step__step-button--unvisited {
+  background: var(--theme-border, #e2e8f0);
+  color: var(--theme-text-secondary, #64748b);
+}
+
+.tpl-step-by-step__step-button:hover:not(:disabled) {
+  transform: scale(1.05);
+  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
+}
+
+.tpl-step-by-step__step-button:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+/* Connector line between steps */
+.tpl-step-by-step__connector {
+  flex: 1;
+  height: 2px;
+  transition: background 200ms ease;
+}
+
+.tpl-step-by-step__connector--visited {
+  background: var(--theme-info, #3b82f6);
+}
+
+.tpl-step-by-step__connector--unvisited {
+  background: var(--theme-border, #e2e8f0);
+}
+
+/* Current step content card */
+.tpl-step-by-step__content {
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  padding: 24px;
+  background: var(--theme-background, #fff);
+}
+
+.tpl-step-by-step__step-title {
+  margin: 0 0 12px;
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-step-by-step__image {
+  width: 100%;
+  border-radius: 6px;
+  margin-bottom: 12px;
+  display: block;
+  object-fit: cover;
+}
+
+.tpl-step-by-step__description {
+  margin: 0;
+  font-size: 14px;
+  color: var(--theme-text-secondary, #475569);
+  line-height: 1.6;
+}
+
+/* Navigation buttons */
+.tpl-step-by-step__nav {
+  display: flex;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.tpl-step-by-step__button {
+  padding: 8px 20px;
+  border-radius: 6px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 200ms ease;
+  font-size: 13px;
+}
+
+.tpl-step-by-step__button--secondary {
+  border: 1px solid var(--theme-border, #e2e8f0);
+  background: var(--theme-background, #fff);
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-step-by-step__button--secondary:hover:not(:disabled) {
+  background: var(--theme-surface, #f8fafc);
+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-step-by-step__button--primary {
+  background: var(--theme-primary, #2563eb);
+  color: #fff;
+  border: none;
+}
+
+.tpl-step-by-step__button--primary:hover:not(:disabled) {
+  background: #1d4ed8;
+  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.3);
+}
+
+.tpl-step-by-step__button--primary:disabled,
+.tpl-step-by-step__button--secondary:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+/* Empty state */
+.tpl-step-by-step__empty {
+  padding: 20px;
+  color: var(--theme-text-secondary, #64748b);
+  font-size: 13px;
+  text-align: center;
+}
+
+/* ─── Editor Styles ────────────────────────────────────────────────── */
+
+.tpl-step-by-step-editor {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.tpl-step-by-step-editor__field {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+}
+
+.tpl-step-by-step-editor__label {
+  font-size: 12px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-step-by-step-editor__input,
+.tpl-step-by-step-editor__textarea {
+  width: 100%;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 6px;
+  padding: 8px 10px;
+  font-size: 13px;
+  background: var(--theme-background, #fff);
+  color: var(--theme-text, #1e293b);
+  font-family: inherit;
+}
+
+.tpl-step-by-step-editor__input:focus,
+.tpl-step-by-step-editor__textarea:focus {
+  outline: none;
+  border-color: var(--theme-primary, #2563eb);
+  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.12);
+}
+
+.tpl-step-by-step-editor__step-card {
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 6px;
+  padding: 12px;
+  background: var(--theme-surface, #f8fafc);
+}
+
+.tpl-step-by-step-editor__step-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 8px;
+}
+
+.tpl-step-by-step-editor__step-label {
+  font-weight: 600;
+  font-size: 13px;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-step-by-step-editor__remove-btn {
+  background: none;
+  border: none;
+  color: var(--theme-error, #ef4444);
+  font-size: 20px;
+  cursor: pointer;
+  padding: 0;
+  transition: color 200ms ease;
+}
+
+.tpl-step-by-step-editor__remove-btn:hover {
+  color: #dc2626;
+}
+
+.tpl-step-by-step-editor__add-btn {
+  width: 100%;
+  padding: 10px;
+  border: 2px dashed var(--theme-border, #cbd5e1);
+  border-radius: 6px;
+  background: transparent;
+  color: var(--theme-primary, #2563eb);
+  font-weight: 500;
+  cursor: pointer;
+  transition: all 200ms ease;
+  font-size: 13px;
+}
+
+.tpl-step-by-step-editor__add-btn:hover {
+  background: var(--theme-surface, #f8fafc);
+  border-color: var(--theme-primary, #2563eb);
+}
+
+@media (max-width: 768px) {
+  .tpl-step-by-step__progress {
+    flex-wrap: wrap;
+  }
+
+  .tpl-step-by-step__nav {
+    flex-direction: column;
+  }
+
+  .tpl-step-by-step__button {
+    width: 100%;
+  }
+}
