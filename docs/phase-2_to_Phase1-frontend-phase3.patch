+/**
+ * AudioSlide — Audio-based content slide with optional transcript.
+ * BEM Convention: .tpl-audio-slide
+ * Category: media-rich
+ */
+
+/* ─── Preview Container ─────────────────────────────────────── */
+.tpl-audio-slide {
+  position: relative;
+  width: 100%;
+}
+
+.tpl-audio-slide__title {
+  margin: 0 0 12px 0;
+  font-size: 1.25rem;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  line-height: 1.4;
+}
+
+.tpl-audio-slide__description {
+  margin: 0 0 16px 0;
+  font-size: 14px;
+  color: var(--theme-text-secondary, #64748b);
+  line-height: 1.6;
+}
+
+.tpl-audio-slide__player-container {
+  background: var(--theme-surface, #f8fafc);
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  padding: 20px;
+  margin-bottom: 16px;
+}
+
+.tpl-audio-slide__player {
+  width: 100%;
+  outline: none;
+}
+
+.tpl-audio-slide__player:focus-visible {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+  border-radius: 4px;
+}
+
+.tpl-audio-slide__placeholder {
+  width: 100%;
+  height: 150px;
+  background: var(--theme-surface, #f8fafc);
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  color: var(--theme-text-secondary, #64748b);
+  font-size: 14px;
+  gap: 8px;
+}
+
+.tpl-audio-slide__placeholder-icon {
+  font-size: 36px;
+  opacity: 0.5;
+}
+
+.tpl-audio-slide__visual {
+  width: 100%;
+  max-width: 400px;
+  margin: 0 auto 16px auto;
+  border-radius: 8px;
+  overflow: hidden;
+}
+
+.tpl-audio-slide__visual-img {
+  width: 100%;
+  height: auto;
+  display: block;
+  border-radius: 8px;
+}
+
+.tpl-audio-slide__transcript {
+  background: var(--theme-surface, #f8fafc);
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  padding: 16px;
+  margin-top: 16px;
+}
+
+.tpl-audio-slide__transcript-title {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 8px 0;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+}
+
+.tpl-audio-slide__transcript-text {
+  font-size: 14px;
+  color: var(--theme-text-secondary, #64748b);
+  line-height: 1.7;
+  margin: 0;
+  white-space: pre-wrap;
+}
+
+/* ─── Editor Container ─────────────────────────────────────── */
+.tpl-audio-slide-editor {
+  width: 100%;
+}
+
+.tpl-audio-slide-editor__field {
+  margin-bottom: 12px;
+}
+
+.tpl-audio-slide-editor__label {
+  display: block;
+  font-size: 12px;
+  font-weight: 500;
+  margin-bottom: 4px;
+  color: var(--theme-text, #1e293b);
+}
+
+.tpl-audio-slide-editor__input {
+  width: 100%;
+  padding: 6px 8px;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 4px;
+  font-size: 13px;
+  color: var(--theme-text, #1e293b);
+  background: var(--theme-background, #ffffff);
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.tpl-audio-slide-editor__input::placeholder {
+  color: var(--theme-text-secondary, #64748b);
+}
+
+.tpl-audio-slide-editor__input:hover {
+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-audio-slide-editor__input:focus {
+  outline: none;
+  border-color: var(--theme-primary, #2563eb);
+  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
+}
+
+.tpl-audio-slide-editor__input:disabled {
+  background: var(--theme-surface, #f8fafc);
+  color: var(--theme-text-secondary, #64748b);
+  cursor: not-allowed;
+}
+
+.tpl-audio-slide-editor__textarea {
+  width: 100%;
+  min-height: 80px;
+  padding: 6px 8px;
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 4px;
+  font-size: 13px;
+  color: var(--theme-text, #1e293b);
+  background: var(--theme-background, #ffffff);
+  font-family: inherit;
+  resize: vertical;
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+
+.tpl-audio-slide-editor__textarea::placeholder {
+  color: var(--theme-text-secondary, #64748b);
+}
+
+.tpl-audio-slide-editor__textarea:hover {
+  border-color: var(--theme-primary, #2563eb);
+}
+
+.tpl-audio-slide-editor__textarea:focus {
+  outline: none;
+  border-color: var(--theme-primary, #2563eb);
+  box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
+}
+
+/* ─── Responsive Design ────────────────────────────────────── */
+@media (max-width: 768px) {
+  .tpl-audio-slide__title {
+    font-size: 1.125rem;
+    margin-bottom: 10px;
+  }
+
+  .tpl-audio-slide__description {
+    font-size: 13px;
+    margin-bottom: 14px;
+  }
+
+  .tpl-audio-slide__player-container {
+    padding: 16px;
+  }
+
+  .tpl-audio-slide__placeholder {
+    height: 120px;
+  }
+
+  .tpl-audio-slide__placeholder-icon {
+    font-size: 32px;
+  }
+
+  .tpl-audio-slide__transcript {
+    padding: 14px;
+  }
+
+  .tpl-audio-slide__transcript-text {
+    font-size: 13px;
+  }
+}
+
+@media (max-width: 375px) {
+  .tpl-audio-slide__title {
+    font-size: 1rem;
+  }
+
+  .tpl-audio-slide__player-container {
