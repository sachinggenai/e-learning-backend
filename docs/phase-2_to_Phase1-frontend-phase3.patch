+}
+
+.preview-v2__page-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  border: 2px solid rgba(255,255,255,0.2);
+  background: transparent;
+  cursor: pointer;
+  padding: 0;
+  transition: all var(--transition-fast);
+  flex-shrink: 0;
+}
+
+.preview-v2__page-dot:hover {
+  border-color: var(--color-primary-400);
+  transform: scale(1.2);
