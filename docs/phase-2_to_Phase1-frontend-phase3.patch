+
+    fireEvent.click(screen.getByRole('tab', { name: 'Overview' }));
+    fireEvent.click(screen.getByRole('tab', { name: 'Details' }));
+    fireEvent.click(screen.getByRole('tab', { name: 'Summary' }));
+
+    expect(onComplete).toHaveBeenCalledWith('cmp-tabs');
