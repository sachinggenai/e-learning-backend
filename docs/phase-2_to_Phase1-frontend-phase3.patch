+/* ============================================================
+   Component Picker — Wix Dark Modal Theme
+   ============================================================ */
+
+/* ─── Overlay ──────────────────────────────────────────────────── */
+.component-picker__overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(10, 10, 18, 0.6);
+  backdrop-filter: blur(6px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: var(--z-modal, 1000);
+  animation: cpFadeIn 0.15s ease-out;
+}
+
+@keyframes cpFadeIn {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+/* ─── Modal ────────────────────────────────────────────────────── */
+.component-picker {
+  background: var(--sidebar-bg);
+  border: 1px solid var(--sidebar-border);
+  border-radius: var(--radius-xl, 12px);
+  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
+  width: 90vw;
+  max-width: 900px;
+  max-height: 80vh;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+  animation: cpSlideUp 0.2s ease-out;
+}
+
+@keyframes cpSlideUp {
+  from { transform: translateY(20px); opacity: 0; }
+  to { transform: translateY(0); opacity: 1; }
+}
+
+/* ─── Header ───────────────────────────────────────────────────── */
+.component-picker__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: 14px 20px;
+  border-bottom: 1px solid var(--sidebar-border);
+}
+
+.component-picker__title {
+  margin: 0;
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--sidebar-text-bright);
+}
+
+.component-picker__close {
+  background: none;
+  border: none;
+  cursor: pointer;
+  padding: 4px;
+  border-radius: var(--radius-md, 6px);
+  color: var(--sidebar-text-muted);
+  transition: background 0.15s, color 0.15s;
+}
+
+.component-picker__close:hover {
+  background: var(--sidebar-bg-hover);
+  color: var(--sidebar-text-bright);
+}
+
+/* ─── Search ───────────────────────────────────────────────────── */
+.component-picker__search {
+  position: relative;
+  padding: 12px 20px;
+  border-bottom: 1px solid var(--sidebar-border);
+}
+
+.component-picker__search-icon {
+  position: absolute;
+  left: 32px;
+  top: 50%;
+  transform: translateY(-50%);
+  color: var(--sidebar-text-muted);
+  pointer-events: none;
+}
+
+.component-picker__search-input {
+  width: 100%;
+  padding: 8px 12px 8px 36px;
+  border: 1px solid var(--sidebar-border);
+  border-radius: var(--radius-md, 8px);
+  font-size: 14px;
+  background: var(--sidebar-section-bg);
+  color: var(--sidebar-text-bright);
+  outline: none;
+  transition: border-color 0.15s, box-shadow 0.15s;
+}
+
+.component-picker__search-input:focus {
+  border-color: var(--sidebar-accent);
+  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.15);
+}
+
+.component-picker__search-input::placeholder {
+  color: var(--sidebar-text-muted);
+}
+
+.component-picker__search-clear {
+  position: absolute;
+  right: 32px;
+  top: 50%;
+  transform: translateY(-50%);
+  background: none;
+  border: none;
+  cursor: pointer;
+  padding: 4px;
+  color: var(--sidebar-text-muted);
+}
+
+.component-picker__search-clear:hover {
+  color: var(--sidebar-text-bright);
+}
+
+/* ─── Body ─────────────────────────────────────────────────────── */
+.component-picker__body {
+  display: flex;
+  flex: 1;
+  overflow: hidden;
+}
+
+/* ─── Category Sidebar ─────────────────────────────────────────── */
+.component-picker__categories {
+  width: 200px;
+  min-width: 200px;
+  border-right: 1px solid var(--sidebar-border);
+  overflow-y: auto;
+  padding: 8px;
+  background: var(--sidebar-section-bg);
+}
+
+.component-picker__category-btn {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  padding: 8px 12px;
+  border: none;
+  border-radius: var(--radius-md, 6px);
+  background: transparent;
+  cursor: pointer;
+  font-size: 13px;
+  color: var(--sidebar-text);
+  text-align: left;
+  transition: background 0.15s;
+}
+
+.component-picker__category-btn:hover {
+  background: var(--sidebar-bg-hover);
+}
+
+.component-picker__category-btn--active {
+  background: var(--sidebar-accent);
+  color: white;
+}
+
+.component-picker__category-btn--active:hover {
+  background: var(--sidebar-accent);
+  filter: brightness(0.9);
+}
+
+.component-picker__category-name {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.component-picker__category-count {
+  font-size: 11px;
+  background: rgba(255, 255, 255, 0.08);
+  padding: 1px 6px;
+  border-radius: 10px;
+  min-width: 20px;
+  text-align: center;
+}
+
+.component-picker__category-btn--active .component-picker__category-count {
+  background: rgba(255, 255, 255, 0.2);
+}
+
+/* ─── Component Grid ───────────────────────────────────────────── */
+.component-picker__grid {
+  flex: 1;
+  overflow-y: auto;
+  padding: 16px;
+}
+
+.component-picker__empty {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  height: 200px;
+  color: var(--sidebar-text-muted);
+  font-size: 14px;
+}
+
+.component-picker__category-group {
+  margin-bottom: 24px;
+}
+
+.component-picker__category-title {
+  margin: 0 0 12px;
+  font-size: 11px;
+  font-weight: 600;
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+  color: var(--sidebar-text-muted);
+}
+
+.component-picker__category-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
+  gap: 10px;
+}
+
+/* ─── Component Card ───────────────────────────────────────────── */
+.component-card {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: 14px;
+  border: 1px solid var(--sidebar-border);
+  border-radius: var(--radius-md, 8px);
+  background: var(--sidebar-section-bg);
+  cursor: pointer;
+  text-align: left;
+  transition: border-color 0.15s, box-shadow 0.15s, transform 0.1s;
+}
+
+.component-card:hover {
+  border-color: var(--sidebar-accent);
+  box-shadow: 0 2px 8px rgba(99, 102, 241, 0.15);
+  transform: translateY(-1px);
+}
+
+.component-card:focus-visible {
+  outline: 2px solid var(--sidebar-accent);
+  outline-offset: 2px;
+}
+
+.component-card__header {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 6px;
+}
+
+.component-card__icon {
+  font-size: 18px;
+  line-height: 1;
+}
+
+.component-card__name {
+  font-size: 14px;
+  font-weight: 600;
+  color: var(--sidebar-text-bright);
+}
+
+.component-card__description {
+  font-size: 12px;
+  color: var(--sidebar-text-muted);
+  margin: 0 0 8px;
+  line-height: 1.4;
+  display: -webkit-box;
+  -webkit-line-clamp: 2;
+  -webkit-box-orient: vertical;
+  overflow: hidden;
+}
+
+.component-card__badges {
+  display: flex;
+  gap: 4px;
+  flex-wrap: wrap;
+}
+
+.component-card__badge {
+  font-size: 10px;
+  padding: 2px 6px;
+  border-radius: 4px;
+  font-weight: 500;
+}
+
+.component-card__badge--scoring {
+  background: rgba(99, 102, 241, 0.15);
+  color: #a5b4fc;
+}
+
+.component-card__badge--audio {
+  background: rgba(236, 72, 153, 0.15);
+  color: #f9a8d4;
+}
+
+.component-card__badge--interact {
+  background: rgba(34, 197, 94, 0.15);
+  color: #86efac;
+}
+
+/* ─── Responsive ───────────────────────────────────────────────── */
+@media (max-width: 640px) {
+  .component-picker {
+    width: 95vw;
+    max-height: 90vh;
+  }
+
+  .component-picker__body {
+    flex-direction: column;
+  }
+
+  .component-picker__categories {
+    width: 100%;
+    min-width: unset;
+    border-right: none;
+    border-bottom: 1px solid var(--sidebar-border);
+    display: flex;
+    overflow-x: auto;
+    padding: 4px 8px;
+    gap: 4px;
+  }
+
+  .component-picker__category-btn {
+    white-space: nowrap;
+    flex-shrink: 0;
+  }
+
+  .component-picker__category-grid {
+    grid-template-columns: 1fr;
+  }
+}
