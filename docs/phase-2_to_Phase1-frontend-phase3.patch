+/* ================================================================
+   ComponentList — Wix-Style Canvas Component Layout
+   ================================================================ */
+
+.component-list {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3);
+  padding: var(--space-3) 0;
+}
+
+/* ─── Items ────────────────────────────────────────────────────── */
+.component-list__items {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2);
+}
+
+.component-list__item {
+  width: 100%;
+}
+
+/* ─── Empty state ──────────────────────────────────────────────── */
+.component-list__empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: var(--space-10) var(--space-5);
+  border: 2px dashed var(--color-gray-300);
+  border-radius: var(--radius-lg);
+  text-align: center;
+  color: var(--text-tertiary);
+  background: rgba(99, 102, 241, 0.02);
+  transition: border-color var(--transition-normal), background var(--transition-normal);
+}
+
+.component-list__empty:hover {
+  border-color: var(--color-primary-300);
+  background: rgba(99, 102, 241, 0.04);
+}
+
+.component-list__empty p {
+  margin: 0 0 var(--space-3);
+  font-size: var(--text-sm);
+  line-height: var(--leading-relaxed);
+}
+
+/* ─── Add button ───────────────────────────────────────────────── */
+.component-list__add-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: var(--space-1_5) var(--space-4);
+  border: 1px dashed var(--color-gray-300);
+  border-radius: var(--radius-md);
+  background: transparent;
+  color: var(--color-primary-600);
+  font-size: var(--text-sm);
+  font-weight: var(--font-medium);
+  font-family: var(--font-sans);
+  cursor: pointer;
+  transition: all var(--transition-fast);
+}
+
+.component-list__add-btn:hover {
+  border-color: var(--color-primary-400);
+  background: var(--color-primary-50);
+  color: var(--color-primary-700);
+}
+
+.component-list__add-btn:focus-visible {
+  outline: 2px solid var(--color-primary-500);
+  outline-offset: 2px;
+}
+
+.component-list__add-btn--bottom {
+  align-self: center;
+  margin-top: var(--space-2);
+}
