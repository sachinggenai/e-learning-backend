+    font-size: 28px;
+  }
+
+  .tpl-infographic__icon {
+    font-size: 32px;
+  }
+}
+
+@media (max-width: 375px) {
+  .tpl-infographic__title {
+    font-size: 1rem;
+  }
+
+  .tpl-infographic__section {
+    padding: 14px;
+  }
+
+  .tpl-infographic__stat-value {
+    font-size: 24px;
+  }
+
+  .tpl-infographic__icon {
+    font-size: 28px;
+  }
+
+  .tpl-infographic-editor__row {
+    flex-direction: column;
+  }
+
+  .tpl-infographic-editor__row--icon,
+  .tpl-infographic-editor__row--color {
+    width: 100%;
+  }
+}
