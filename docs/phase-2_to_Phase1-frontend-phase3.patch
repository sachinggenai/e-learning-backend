+/* ============================================================
+   Validation Error Modal — Wix Design System
+   ============================================================ */
+
+/* ── Overlay ─────────────────────────────────────────────── */
+.vem-overlay {
+  position: fixed;
+  inset: 0;
+  background: rgba(10, 10, 18, 0.55);
+  backdrop-filter: blur(6px);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  z-index: var(--z-modal, 1000);
+  animation: vemFadeIn 0.15s ease-out;
+}
+
+@keyframes vemFadeIn {
+  from { opacity: 0; }
+  to   { opacity: 1; }
+}
+
+/* ── Modal container ─────────────────────────────────────── */
+.vem-container {
+  background: var(--panel-bg, #ffffff);
+  border-radius: var(--radius-xl, 12px);
+  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25), 0 0 0 1px rgba(0, 0, 0, 0.06);
+  max-width: 960px;
+  width: 95vw;
+  max-height: 90vh;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+  animation: vemSlideUp 0.2s ease-out;
+}
+
+@keyframes vemSlideUp {
+  from { opacity: 0; transform: translateY(8px) scale(0.98); }
+  to   { opacity: 1; transform: translateY(0) scale(1); }
+}
+
+/* ── Header ──────────────────────────────────────────────── */
+.vem-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: var(--space-4, 16px) var(--space-5, 20px);
+  border-bottom: 1px solid var(--surface-border, #e2e8f0);
+  background: var(--canvas-bg, #f8fafc);
+}
+
+.vem-header__left {
+  display: flex;
+  align-items: center;
+  gap: var(--space-3, 12px);
+}
+
+.vem-header__icon {
+  color: #f59e0b;
+  flex-shrink: 0;
+}
+
+.vem-header__icon svg { width: 24px; height: 24px; }
+
+.vem-header__title {
+  margin: 0;
+  font-size: var(--text-lg, 18px);
+  font-weight: var(--font-semibold, 600);
+  color: var(--text-primary, #1e293b);
+}
+
+.vem-header__subtitle {
+  margin: 2px 0 0;
+  font-size: var(--text-xs, 12px);
+  color: var(--text-secondary, #64748b);
+}
+
+.vem-header__actions {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+}
+
+.vem-btn--autofix {
+  padding: 4px 10px;
+  font-size: var(--text-xs, 12px);
+  font-weight: var(--font-medium, 500);
+  background: rgba(16, 185, 129, 0.1);
+  color: #059669;
+  border: 1px solid rgba(16, 185, 129, 0.2);
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+  transition: background var(--transition-fast, 100ms ease);
+}
+.vem-btn--autofix:hover { background: rgba(16, 185, 129, 0.2); }
+
+.vem-btn--icon {
+  padding: 6px;
+  background: none;
+  border: none;
+  color: var(--text-secondary, #64748b);
+  cursor: pointer;
+  border-radius: var(--radius-sm, 4px);
+  transition: color var(--transition-fast, 100ms ease), background var(--transition-fast, 100ms ease);
+}
+.vem-btn--icon:hover {
+  color: var(--text-primary, #1e293b);
+  background: var(--surface-bg, #f1f5f9);
+}
+.vem-btn--icon svg { width: 20px; height: 20px; }
+.vem-btn--icon-lg svg { width: 22px; height: 22px; }
+
+/* ── Tabs ────────────────────────────────────────────────── */
+.vem-tabs {
+  display: flex;
+  gap: var(--space-1, 4px);
+  padding: 0 var(--space-5, 20px);
+  border-bottom: 1px solid var(--surface-border, #e2e8f0);
+  background: var(--panel-bg, #ffffff);
+}
+
+.vem-tab {
+  padding: var(--space-3, 12px) var(--space-2, 8px);
+  border: none;
+  border-bottom: 2px solid transparent;
+  background: none;
+  font-size: var(--text-sm, 13px);
+  font-weight: var(--font-medium, 500);
+  color: var(--text-secondary, #64748b);
+  cursor: pointer;
+  transition: color var(--transition-fast), border-color var(--transition-fast);
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+}
+
+.vem-tab:hover {
+  color: var(--text-primary, #1e293b);
+  border-bottom-color: var(--surface-border, #cbd5e1);
+}
+
+.vem-tab--active {
+  color: var(--color-primary-600, #6366f1);
+  border-bottom-color: var(--color-primary-600, #6366f1);
+}
+
+.vem-tab__badge {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 1px 7px;
+  font-size: 11px;
+  font-weight: var(--font-semibold, 600);
+  border-radius: var(--radius-full, 99px);
+  background: var(--surface-bg, #f1f5f9);
+  color: var(--text-secondary, #64748b);
+}
+.vem-tab--active .vem-tab__badge {
+  background: rgba(99, 102, 241, 0.1);
+  color: var(--color-primary-600, #6366f1);
+}
+
+/* ── Content ─────────────────────────────────────────────── */
+.vem-content {
+  flex: 1;
+  overflow: hidden;
+  display: flex;
+  flex-direction: column;
+}
+
+/* Empty state */
+.vem-empty {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: var(--space-8, 32px);
+  text-align: center;
+}
+.vem-empty__icon { color: #10b981; margin-bottom: var(--space-3, 12px); }
+.vem-empty__icon svg { width: 48px; height: 48px; }
+.vem-empty__title {
+  font-size: var(--text-lg, 18px);
+  font-weight: var(--font-medium, 500);
+  color: var(--text-primary, #1e293b);
+  margin: 0 0 var(--space-1, 4px);
+}
+.vem-empty__text {
+  font-size: var(--text-sm, 13px);
+  color: var(--text-secondary, #64748b);
+  margin: 0;
+}
+
+/* Action bar */
+.vem-action-bar {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: var(--space-2, 8px) var(--space-4, 16px);
+  background: var(--canvas-bg, #f8fafc);
+  border-bottom: 1px solid var(--surface-border, #e2e8f0);
+  font-size: var(--text-xs, 12px);
+  color: var(--text-secondary, #64748b);
+}
+
+.vem-action-bar__actions {
+  display: flex;
+  gap: var(--space-2, 8px);
+}
+
+.vem-btn--sm {
+  padding: 3px 10px;
+  font-size: var(--text-xs, 12px);
+  font-weight: var(--font-medium, 500);
+  border: none;
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+  transition: background var(--transition-fast);
+}
+
+.vem-btn--warning {
+  background: rgba(245, 158, 11, 0.1);
+  color: #d97706;
+}
+.vem-btn--warning:hover { background: rgba(245, 158, 11, 0.2); }
+
+.vem-btn--neutral {
+  background: var(--surface-bg, #f1f5f9);
+  color: var(--text-primary, #1e293b);
+}
+.vem-btn--neutral:hover { background: var(--surface-border, #e2e8f0); }
+
+/* Scrollable area */
+.vem-scroll {
+  flex: 1;
+  overflow-y: auto;
+  padding: var(--space-4, 16px);
+  max-height: 400px;
+}
+
+/* ── Category groups ─────────────────────────────────────── */
+.vem-categories {
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-3, 12px);
+}
+
+.vem-category {
+  border: 1px solid var(--surface-border, #e2e8f0);
+  border-radius: var(--radius-lg, 8px);
+  overflow: hidden;
+}
+
+.vem-category__header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  width: 100%;
+  padding: var(--space-3, 12px) var(--space-4, 16px);
+  background: var(--canvas-bg, #f8fafc);
+  border: none;
+  cursor: pointer;
+  transition: background var(--transition-fast);
+}
+.vem-category__header:hover { background: var(--surface-bg, #f1f5f9); }
+
+.vem-category__header-left {
+  display: flex;
+  align-items: center;
+  gap: var(--space-2, 8px);
+}
+
+.vem-category__chevron {
+  color: var(--text-secondary, #64748b);
+  flex-shrink: 0;
+}
+.vem-category__chevron svg { width: 16px; height: 16px; }
+
+.vem-category__name {
+  font-size: var(--text-sm, 13px);
+  font-weight: var(--font-medium, 500);
+  color: var(--text-primary, #1e293b);
+}
+
+.vem-category__count {
+  padding: 2px 8px;
+  font-size: 11px;
+  font-weight: var(--font-semibold, 600);
+  background: var(--surface-bg, #f1f5f9);
+  color: var(--text-secondary, #64748b);
+  border-radius: var(--radius-full, 99px);
+}
+
+/* ── Error items ─────────────────────────────────────────── */
+.vem-errors { border-top: 1px solid var(--surface-border, #e2e8f0); }
+
+.vem-error {
+  padding: var(--space-3, 12px) var(--space-4, 16px);
+  border-bottom: 1px solid var(--surface-border, #e2e8f0);
+}
+.vem-error:last-child { border-bottom: none; }
+
+.vem-error--error   { background: rgba(239, 68, 68, 0.04); }
+.vem-error--warning { background: rgba(245, 158, 11, 0.04); }
+.vem-error--info    { background: rgba(59, 130, 246, 0.04); }
+
+.vem-error__row {
+  display: flex;
+  align-items: flex-start;
+  gap: var(--space-3, 12px);
+}
+
+.vem-error__icon { flex-shrink: 0; padding-top: 2px; }
+.vem-error__icon svg { width: 18px; height: 18px; }
+.vem-error__icon--error   svg { color: #ef4444; }
+.vem-error__icon--warning svg { color: #f59e0b; }
+.vem-error__icon--info    svg { color: #3b82f6; }
+
+.vem-error__body { flex: 1; min-width: 0; }
+
+.vem-error__top {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: var(--space-2, 8px);
+}
+
+.vem-error__message {
+  font-size: var(--text-sm, 13px);
+  font-weight: var(--font-medium, 500);
+  color: var(--text-primary, #1e293b);
+  margin: 0;
+}
+
+.vem-error__actions {
+  display: flex;
+  align-items: center;
+  gap: var(--space-1, 4px);
+  flex-shrink: 0;
+}
+
+.vem-btn--pill {
+  padding: 2px 8px;
+  font-size: 11px;
+  font-weight: var(--font-medium, 500);
+  border: none;
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+  transition: background var(--transition-fast);
+}
+.vem-btn--green  { background: rgba(16, 185, 129, 0.1); color: #059669; }
+.vem-btn--green:hover { background: rgba(16, 185, 129, 0.2); }
+.vem-btn--gray   { background: var(--surface-bg, #f1f5f9); color: var(--text-secondary); }
+.vem-btn--gray:hover { background: var(--surface-border, #e2e8f0); }
+.vem-btn--blue   { background: rgba(59, 130, 246, 0.1); color: #2563eb; }
+.vem-btn--blue:hover { background: rgba(59, 130, 246, 0.2); }
+
+.vem-error__meta {
+  display: flex;
+  gap: var(--space-3, 12px);
+  margin-top: 4px;
+  font-size: 11px;
+  color: var(--text-secondary, #64748b);
+}
+
+/* Expanded details */
+.vem-error__details {
+  margin-top: var(--space-3, 12px);
+  padding-left: 30px;
+  display: flex;
+  flex-direction: column;
+  gap: var(--space-2, 8px);
+}
+
+.vem-detail__label {
+  font-size: var(--text-xs, 12px);
+  font-weight: var(--font-medium, 500);
+  color: var(--text-primary, #1e293b);
+  margin: 0 0 4px;
+}
+
+.vem-detail__pre {
+  font-size: 11px;
+  background: var(--surface-bg, #f1f5f9);
+  border-radius: var(--radius-sm, 4px);
+  padding: var(--space-2, 8px);
+  margin: 0;
+  overflow-x: auto;
+  color: var(--text-primary, #1e293b);
+  font-family: var(--font-mono, 'SF Mono', 'Fira Code', monospace);
+}
+
+.vem-detail__suggestion {
+  font-size: var(--text-xs, 12px);
+  background: rgba(59, 130, 246, 0.06);
+  border-radius: var(--radius-sm, 4px);
+  padding: var(--space-2, 8px);
+  margin: 0;
+  color: var(--text-primary, #1e293b);
+}
+
+/* ── Footer ──────────────────────────────────────────────── */
+.vem-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  padding: var(--space-3, 12px) var(--space-5, 20px);
+  border-top: 1px solid var(--surface-border, #e2e8f0);
+  background: var(--canvas-bg, #f8fafc);
+}
+
+.vem-footer__status {
+  font-size: var(--text-sm, 13px);
+}
+.vem-footer__status--error   { color: #ef4444; font-weight: var(--font-medium, 500); }
+.vem-footer__status--warning { color: #d97706; }
+.vem-footer__status--success { color: #059669; font-weight: var(--font-medium, 500); }
+
+.vem-footer__buttons {
+  display: flex;
+  gap: var(--space-2, 8px);
+}
+
+.vem-btn--close {
+  padding: 6px 16px;
+  font-size: var(--text-sm, 13px);
+  font-weight: var(--font-medium, 500);
+  color: var(--text-primary, #1e293b);
+  background: var(--panel-bg, #ffffff);
+  border: 1px solid var(--surface-border, #e2e8f0);
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+  transition: background var(--transition-fast);
+}
+.vem-btn--close:hover { background: var(--surface-bg, #f1f5f9); }
+
+.vem-btn--continue {
+  padding: 6px 16px;
+  font-size: var(--text-sm, 13px);
+  font-weight: var(--font-medium, 500);
+  color: #ffffff;
+  background: #059669;
+  border: none;
+  border-radius: var(--radius-md, 6px);
+  cursor: pointer;
+  transition: background var(--transition-fast);
+}
+.vem-btn--continue:hover { background: #047857; }
