+
+  # ── Scoring ─────────────────────────────────
+  /courses/{courseId}/scoring:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    get:
+      tags: [Scoring]
+      operationId: getScoringConfig
+      summary: Get scoring configuration
+      responses:
+        "200":
+          description: Scoring configuration
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ScoringConfigResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    patch:
+      tags: [Scoring]
+      operationId: updateScoringConfig
+      summary: Update scoring configuration
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ScoringConfigUpdateRequest"
+      responses:
+        "200":
+          description: Updated scoring config
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ScoringConfigResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /courses/{courseId}/scoring/validate:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    post:
+      tags: [Scoring]
+      operationId: validateScoringConfig
+      summary: Validate scoring configuration
+      description: Checks weights sum to 1.0, components are scorable, etc.
+      responses:
+        "200":
+          description: Validation result
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ValidationResult"
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  /courses/{courseId}/scoring/calculate:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    post:
+      tags: [Scoring]
+      operationId: calculateScore
+      summary: Calculate score from submitted answers
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ScoreCalculateRequest"
+      responses:
+        "200":
+          description: Score calculation result
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ScoreCalculateResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  # ── Completion ──────────────────────────────
+  /courses/{courseId}/completion:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    get:
+      tags: [Completion]
+      operationId: getCourseCompletion
+      summary: Get course completion status
+      responses:
+        "200":
+          description: Course completion breakdown
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/CourseCompletionResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  /courses/{courseId}/pages/{pageId}/completion:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+      - $ref: "#/components/parameters/PageId"
+    get:
+      tags: [Completion]
+      operationId: getPageCompletion
+      summary: Get page completion status
+      responses:
+        "200":
+          description: Page completion breakdown
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/PageCompletionResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    post:
+      tags: [Completion]
+      operationId: recordPageCompletion
+      summary: Record page completion event
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/PageCompletionEvent"
+      responses:
+        "200":
+          description: Recorded completion
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/PageCompletionResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  /courses/{courseId}/interactions:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    post:
+      tags: [Completion]
+      operationId: recordInteraction
+      summary: Record a component interaction event
+      description: |
+        Used in preview mode and non-SCORM deployments.
+        For SCORM exports, tracking happens client-side via cmi.interactions.
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/InteractionEvent"
+      responses:
+        "201":
+          description: Interaction recorded
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/InteractionEventResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  # ── Audio ───────────────────────────────────
+  /assets/audio:
+    post:
+      tags: [Audio]
+      operationId: uploadAudio
+      summary: Upload an audio file
+      description: Extends existing media upload with audio metadata extraction
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              required: [file]
+              properties:
+                file:
+                  type: string
+                  format: binary
+                  description: Audio file (mp3, wav, ogg, aac, m4a)
+                courseId:
+                  type: string
+                  description: Associate with a course (optional)
+                label:
+                  type: string
+                  description: Display name for this audio
+      responses:
+        "201":
+          description: Audio uploaded
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/AudioAssetResponse"
+        "413":
+          description: File too large (max 50MB)
+        "415":
+          description: Unsupported audio format
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /assets/audio/{audioId}:
+    parameters:
+      - $ref: "#/components/parameters/AudioId"
+    get:
+      tags: [Audio]
+      operationId: getAudioMetadata
+      summary: Get audio file metadata
+      responses:
+        "200":
+          description: Audio metadata
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/AudioAssetResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    patch:
+      tags: [Audio]
+      operationId: updateAudioMetadata
+      summary: Update audio metadata (label, transcript)
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/AudioMetadataUpdateRequest"
+      responses:
+        "200":
+          description: Updated metadata
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/AudioAssetResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+    delete:
+      tags: [Audio]
+      operationId: deleteAudio
+      summary: Delete an audio file
+      responses:
+        "204":
+          description: Audio deleted
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  /courses/{courseId}/narration:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    get:
+      tags: [Audio]
+      operationId: getCourseNarration
+      summary: List all audio items across all pages and components
+      responses:
+        "200":
+          description: Course narration overview
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/CourseNarrationResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  # ── Export ──────────────────────────────────
+  /export:
+    post:
+      tags: [Export]
+      operationId: exportCourseFromJson
+      summary: Export SCORM package from raw JSON
+      description: Accepts course JSON (legacy or new format), validates, and returns SCORM ZIP
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ExportRequest"
+      responses:
+        "200":
+          description: SCORM package ZIP
+          content:
+            application/zip:
+              schema:
+                type: string
+                format: binary
+          headers:
+            Content-Disposition:
+              schema:
+                type: string
+                example: attachment; filename="course-slug_scorm.zip"
+            X-Export-Warnings:
+              schema:
+                type: string
+              description: Semicolon-separated export warnings
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /export/validate:
+    post:
+      tags: [Export]
+      operationId: validateForExport
+      summary: Validate course data for export
+      description: Validates component types, audio refs, scoring config without generating package
+      requestBody:
+        required: true
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ExportRequest"
+      responses:
+        "200":
+          description: Validation result
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ValidationResult"
+
+  /export/formats:
+    get:
+      tags: [Export]
+      operationId: getExportFormats
+      summary: List available export formats
+      responses:
+        "200":
+          description: Supported export formats
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ExportFormatsResponse"
+
+  /export/scorm/{courseId}:
+    parameters:
+      - $ref: "#/components/parameters/CourseId"
+    post:
+      tags: [Export]
+      operationId: exportPersistedCourse
+      summary: Export SCORM package from a DB-persisted course
+      requestBody:
+        content:
+          application/json:
+            schema:
+              $ref: "#/components/schemas/ScormExportOptions"
+      responses:
+        "200":
+          description: SCORM package ZIP
+          content:
+            application/zip:
+              schema:
+                type: string
+                format: binary
+        "404":
+          $ref: "#/components/responses/NotFound"
+        "422":
+          $ref: "#/components/responses/ValidationError"
+
+  /export/status/{exportId}:
+    parameters:
+      - name: exportId
+        in: path
+        required: true
+        schema:
+          type: string
+    get:
+      tags: [Export]
+      operationId: getExportStatus
+      summary: Get export job status
+      responses:
+        "200":
+          description: Export status
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/ExportStatusResponse"
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  # ── Media ───────────────────────────────────
+  /media/upload:
+    post:
+      tags: [Media]
+      operationId: uploadMedia
+      summary: Upload a media file
+      requestBody:
+        required: true
+        content:
+          multipart/form-data:
+            schema:
+              type: object
+              required: [file]
+              properties:
+                file:
+                  type: string
+                  format: binary
+                course_id:
+                  type: string
+      responses:
+        "201":
+          description: File uploaded
+          content:
+            application/json:
+              schema:
+                $ref: "#/components/schemas/MediaUploadResponse"
+        "413":
+          description: File too large (max 50MB)
+        "415":
+          description: Unsupported file type
+
+  /media/files/{filePath}:
+    parameters:
+      - name: filePath
+        in: path
+        required: true
+        schema:
+          type: string
+    get:
+      tags: [Media]
+      operationId: serveMediaFile
+      summary: Serve a media file
+      responses:
+        "200":
+          description: File content
+          content:
+            "*/*":
+              schema:
+                type: string
+                format: binary
+        "404":
+          $ref: "#/components/responses/NotFound"
+
+  /media/:
+    get:
+      tags: [Media]
+      operationId: listMediaFiles
+      summary: List uploaded media files
+      parameters:
+        - name: course_id
+          in: query
+          schema:
+            type: string
+        - name: category
+          in: query
+          schema:
+            type: string
+            enum: [image, video, audio, document]
+      responses:
+        "200":
+          description: Media file list
+          content:
+            application/json:
+              schema:
+                type: array
+                items:
+                  $ref: "#/components/schemas/MediaFileInfo"
+
+# ─────────────────────────────────────────────
+# COMPONENTS (Schemas, Parameters, Responses)
+# ─────────────────────────────────────────────
+components:
+
+  # ── Parameters ──────────────────────────────
+  parameters:
+    CourseId:
+      name: courseId
+      in: path
+      required: true
+      schema:
+        type: string
+        pattern: "^[a-zA-Z0-9_-]+$"
+      description: Course identifier
+    PageId:
+      name: pageId
+      in: path
+      required: true
+      schema:
+        type: string
+        format: uuid
+      description: Page UUID
+    ComponentId:
+      name: componentId
+      in: path
+      required: true
+      schema:
+        type: string
+        format: uuid
+      description: Component UUID
+    ThemeId:
+      name: themeId
+      in: path
+      required: true
+      schema:
+        type: string
+        format: uuid
+      description: Theme UUID
+    AudioId:
+      name: audioId
+      in: path
+      required: true
+      schema:
+        type: string
+        format: uuid
+      description: Audio asset UUID
+    PageParam:
+      name: page
+      in: query
+      schema:
+        type: integer
+        default: 1
+        minimum: 1
+    LimitParam:
+      name: limit
+      in: query
+      schema:
+        type: integer
+        default: 50
+        minimum: 1
+        maximum: 200
+
+  # ── Responses ───────────────────────────────
+  responses:
+    NotFound:
+      description: Resource not found
+      content:
+        application/json:
+          schema:
+            $ref: "#/components/schemas/ErrorResponse"
+    Conflict:
+      description: Resource conflict (duplicate ID)
+      content:
+        application/json:
+          schema:
+            $ref: "#/components/schemas/ErrorResponse"
+    ValidationError:
+      description: Validation failed
+      content:
+        application/json:
+          schema:
+            $ref: "#/components/schemas/ValidationErrorResponse"
+
+  # ── Schemas ─────────────────────────────────
+  schemas:
+
+    # ── Common ──────────────────────────
+    ErrorResponse:
+      type: object
+      required: [detail]
+      properties:
+        detail:
+          type: string
+
+    ValidationErrorResponse:
+      type: object
+      required: [detail, errors]
+      properties:
+        detail:
+          type: string
+        errors:
+          type: array
+          items:
+            type: object
+            properties:
+              field:
+                type: string
+              message:
+                type: string
+
+    ValidationResult:
+      type: object
+      required: [valid]
+      properties:
+        valid:
+          type: boolean
+        errors:
+          type: array
+          items:
+            type: object
+            properties:
+              field:
+                type: string
+              message:
+                type: string
+        warnings:
+          type: array
+          items:
+            type: object
+            properties:
+              field:
+                type: string
+              message:
+                type: string
+
+    ReorderRequest:
+      type: object
+      required: [orderedIds]
+      properties:
+        orderedIds:
+          type: array
+          items:
+            type: string
+          description: IDs in desired order
+
+    HealthCheckResponse:
+      type: object
+      properties:
+        status:
+          type: string
+          example: ok
+        version:
+          type: string
+        environment:
+          type: string
+        timestamp:
+          type: string
+          format: date-time
+        uptime:
+          type: number
+
+    # ── Audio ───────────────────────────
+    AudioItem:
+      type: object
+      required: [audioUrl, triggerOn]
+      properties:
+        audioId:
+          type: string
+          format: uuid
+          readOnly: true
+        audioUrl:
+          type: string
+          description: URL to audio file from media upload
+        triggerOn:
+          type: string
+          enum: [load, click, interaction]
+        targetInteractionId:
+          type: string
+          nullable: true
+          description: "Interaction point ID (e.g. 'tab-2', 'accordion-panel-1')"
+        autoplay:
+          type: boolean
+          default: false
+        requiredForCompletion:
+          type: boolean
+          default: false
+        duration:
+          type: number
+          description: Duration in seconds
+        label:
+          type: string
+          nullable: true
+          description: Display name for narration list
+        transcript:
+          type: string
+          nullable: true
+          description: Text transcript for accessibility
+
+    AudioConfig:
+      type: object
+      properties:
+        enabled:
+          type: boolean
+          default: false
+        audioItems:
+          type: array
+          items:
+            $ref: "#/components/schemas/AudioItem"
+          default: []
+
+    AudioAssetResponse:
+      type: object
+      properties:
+        audioId:
+          type: string
+          format: uuid
+        audioUrl:
+          type: string
+        duration:
+          type: number
+          nullable: true
+        label:
+          type: string
+          nullable: true
+        transcript:
+          type: string
+          nullable: true
+        mimeType:
+          type: string
+        fileSize:
+          type: integer
+        courseId:
+          type: string
+          nullable: true
+        createdAt:
+          type: string
+          format: date-time
+
+    AudioMetadataUpdateRequest:
+      type: object
+      properties:
+        label:
+          type: string
+        transcript:
+          type: string
+        duration:
+          type: number
+          description: Duration in seconds (if not auto-extracted)
+
+    # ── Completion Criteria ─────────────
+    CompletionCriteria:
+      type: object
+      required: [type]
+      properties:
+        type:
+          type: string
+          enum: [view, interact, audio, score, custom]
+        threshold:
+          type: number
+          minimum: 0
+          maximum: 100
+          nullable: true
+          description: Score threshold (for type=score)
+        requiredInteractions:
+          type: array
+          items:
+            type: string
+          nullable: true
+          description: Interaction IDs that must be performed
+        requiredAudioIds:
+          type: array
+          items:
+            type: string
+          nullable: true
+          description: Audio IDs that must be listened to
+
+    # ── Component Styling ───────────────
+    ComponentStyling:
+      type: object
+      properties:
+        themeOverrides:
+          $ref: "#/components/schemas/ThemeOverrides"
+        layoutPosition:
+          type: string
+          nullable: true
+          description: Grid area name from page layout
+
+    # ── Component ───────────────────────
+    ComponentCreateRequest:
+      type: object
+      required: [componentType, data]
+      properties:
+        componentType:
+          type: string
+          description: Must match a typeId from the Component Type Registry
+        data:
+          type: object
+          description: Component-specific data validated against registry schema
+        audioConfig:
+          $ref: "#/components/schemas/AudioConfig"
+        completionCriteria:
+          $ref: "#/components/schemas/CompletionCriteria"
+        styling:
+          $ref: "#/components/schemas/ComponentStyling"
+
+    ComponentUpdateRequest:
+      type: object
+      properties:
+        data:
+          type: object
+        audioConfig:
+          $ref: "#/components/schemas/AudioConfig"
+        completionCriteria:
+          $ref: "#/components/schemas/CompletionCriteria"
+        styling:
+          $ref: "#/components/schemas/ComponentStyling"
+
+    ComponentResponse:
+      type: object
+      properties:
+        componentId:
+          type: string
+          format: uuid
+        componentType:
+          type: string
+        order:
+          type: integer
+        data:
+          type: object
+        audioConfig:
+          $ref: "#/components/schemas/AudioConfig"
+        completionCriteria:
+          $ref: "#/components/schemas/CompletionCriteria"
+        styling:
+          $ref: "#/components/schemas/ComponentStyling"
+        createdAt:
+          type: string
+          format: date-time
+        updatedAt:
+          type: string
+          format: date-time
+
+    # ── Page Completion ─────────────────
+    PageCompletionConfig:
+      type: object
+      properties:
+        enabled:
+          type: boolean
+          default: true
+        strategy:
+          type: string
+          enum: [all, any, percentage, custom]
+          default: all
+        requiredComponents:
+          type: array
+          items:
+            type: string
+            format: uuid
+          nullable: true
+          description: Component IDs required (for strategy=custom)
+        completionThreshold:
+          type: number
+          minimum: 0
+          maximum: 100
+          nullable: true
+          description: Percentage threshold (for strategy=percentage)
+
+    # ── Page Layout ─────────────────────
+    ComponentPlacement:
+      type: object
+      properties:
+        componentId:
+          type: string
+        gridArea:
+          type: string
+          description: CSS grid area name
+        span:
+          type: integer
+          nullable: true
+          description: Column span for preset layouts
+
+    CustomGrid:
+      type: object
+      properties:
+        columns:
+          type: integer
+          minimum: 1
+          maximum: 4
+        rows:
+          type: string
+          description: "CSS grid-template-rows (e.g. 'auto 1fr auto')"
+        areas:
+          type: array
+          items:
+            type: array
+            items:
+              type: string
+          description: "CSS grid-template-areas"
+        gap:
+          type: string
+          description: "CSS gap (e.g. '16px')"
+
+    PageLayout:
+      type: object
+      properties:
+        preset:
+          type: string
+          enum:
+            - single-column
+            - two-column
+            - three-column
+            - sidebar-left
+            - sidebar-right
+            - grid-2x2
+            - hero-content
+            - full-width
+          nullable: true
+        customGrid:
+          $ref: "#/components/schemas/CustomGrid"
+        spacing:
+          type: string
+          enum: [compact, normal, spacious]
+          default: normal
+        componentPlacements:
+          type: array
+          items:
+            $ref: "#/components/schemas/ComponentPlacement"
+
+    # ── Page Theme ──────────────────────
+    PageThemeConfig:
+      type: object
+      properties:
+        inheritCourse:
+          type: boolean
+          default: true
+        overrides:
+          $ref: "#/components/schemas/ThemeOverrides"
+
+    # ── Page ────────────────────────────
+    PageCreateRequest:
+      type: object
+      required: [title]
+      properties:
+        title:
+          type: string
+          maxLength: 200
+        components:
+          type: array
+          items:
+            $ref: "#/components/schemas/ComponentCreateRequest"
+          description: Optional initial components
+        pageCompletion:
+          $ref: "#/components/schemas/PageCompletionConfig"
+        layout:
+          $ref: "#/components/schemas/PageLayout"
+        theme:
+          $ref: "#/components/schemas/PageThemeConfig"
+
+    PageUpdateRequest:
+      type: object
+      properties:
+        title:
+          type: string
+          maxLength: 200
+        pageCompletion:
+          $ref: "#/components/schemas/PageCompletionConfig"
+        layout:
+          $ref: "#/components/schemas/PageLayout"
+        theme:
+          $ref: "#/components/schemas/PageThemeConfig"
+
+    PageResponse:
+      type: object
+      properties:
+        pageId:
+          type: string
+          format: uuid
+        title:
+          type: string
+        order:
+          type: integer
+        components:
+          type: array
+          items:
+            $ref: "#/components/schemas/ComponentResponse"
+        pageCompletion:
+          $ref: "#/components/schemas/PageCompletionConfig"
+        layout:
+          $ref: "#/components/schemas/PageLayout"
+        theme:
+          $ref: "#/components/schemas/PageThemeConfig"
+        createdAt:
+          type: string
+          format: date-time
+        updatedAt:
+          type: string
+          format: date-time
+
+    # ── Course ──────────────────────────
+    NavigationSettings:
+      type: object
+      properties:
