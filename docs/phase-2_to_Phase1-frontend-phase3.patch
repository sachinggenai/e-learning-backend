+/**
+ * FillBlanks (Fill in the Blanks) - Assessment Template Styles
+ * BEM Convention: .tpl-fill-blanks / .tpl-fill-blanks-editor
+ */
+
+/* ═══════════════════════════════════════════════════════════════
+ * Preview Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.fill-blanks-component {
+  width: 100%;
+  padding: 0;
+}
+
+.fill-blanks__title {
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 16px 0;
+  line-height: 1.5;
+}
+
+.fill-blanks__content {
+  font-size: 15px;
+  line-height: 2;
+  color: var(--theme-text, #1e293b);
+  margin-bottom: 20px;
+}
+
+.fill-blank__inline {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  margin: 0 4px;
+  vertical-align: middle;
+}
+
+.fill-blank__input {
+  display: inline-block;
+  min-width: 100px;
+  max-width: 200px;
+  padding: 4px 12px;
+  border: none;
+  border-bottom: 2px solid var(--theme-primary, #2563eb);
+  background: transparent;
+  font-size: 15px;
+  color: var(--theme-text, #1e293b);
+  outline: none;
+  transition: all 0.2s ease;
+  font-family: inherit;
+}
+
+.fill-blank__input:focus {
+  border-bottom-color: #1d4ed8;
+  background: rgba(37, 99, 235, 0.05);
+}
+
+.fill-blank__input:disabled {
+  cursor: not-allowed;
+  opacity: 0.9;
+}
+
+.fill-blank__input--correct {
+  border-bottom-color: var(--theme-success, #22c55e);
+  background: rgba(34, 197, 94, 0.08);
+  color: var(--theme-text, #1e293b);
+}
+
+.fill-blank__input--incorrect {
+  border-bottom-color: var(--theme-error, #ef4444);
+  background: rgba(239, 68, 68, 0.08);
+  color: var(--theme-text, #1e293b);
+}
+
+.fill-blank__correct-answer {
+  display: inline-block;
+  padding: 4px 10px;
+  background: rgba(34, 197, 94, 0.1);
+  border: 1px solid var(--theme-success, #22c55e);
+  border-radius: 4px;
+  font-size: 13px;
+  font-weight: 500;
+  color: #166534;
+  white-space: nowrap;
+}
+
+.fill-blank__correct-answer::before {
+  content: "✓ ";
+  font-weight: 700;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Editor Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.fill-blanks-editor {
+  width: 100%;
+}
+
+.fill-blanks-editor__blank-row {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin-bottom: 10px;
+  padding: 8px;
+  background: var(--theme-surface, #f8fafc);
+  border-radius: 6px;
+}
+
+.fill-blanks-editor__blank-row code {
+  flex-shrink: 0;
+  padding: 4px 8px;
+  background: var(--theme-background, #ffffff);
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 4px;
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--theme-primary, #2563eb);
+  font-family: 'Courier New', monospace;
+}
+
+.fill-blanks-editor__blank-row input {
+  flex: 1;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Responsive Design
+ * ═══════════════════════════════════════════════════════════════ */
+
+@media (max-width: 768px) {
+  .fill-blanks__title {
+    font-size: 15px;
+  }
+
+  .fill-blanks__content {
+    font-size: 14px;
+    line-height: 1.8;
+  }
+
+  .fill-blank__input {
+    min-width: 80px;
+    max-width: 150px;
+    font-size: 14px;
+  }
+
+  .fill-blank__correct-answer {
+    font-size: 12px;
+    padding: 3px 8px;
+  }
+
+  .fill-blanks-editor__blank-row {
+    flex-direction: column;
+    align-items: stretch;
+    gap: 8px;
+  }
+
+  .fill-blanks-editor__blank-row code {
+    text-align: center;
+  }
+}
