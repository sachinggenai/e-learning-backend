+/**
+ * MCQ (Multiple Choice Question) - Assessment Template Styles
+ * BEM Convention: .tpl-mcq / .tpl-mcq-editor
+ */
+
+/* ═══════════════════════════════════════════════════════════════
+ * Preview Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.mcq-component {
+  width: 100%;
+  padding: 0;
+}
+
+.mcq__question {
+  font-size: 16px;
+  font-weight: 600;
+  color: var(--theme-text, #1e293b);
+  margin: 0 0 16px 0;
+  line-height: 1.5;
+}
+
+.mcq__options {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  margin-bottom: 16px;
+}
+
+.mcq__option {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  padding: 12px 16px;
+  border: 2px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  background: var(--theme-background, #ffffff);
+  cursor: pointer;
+  transition: all 0.2s ease;
+  font-size: 15px;
+  color: var(--theme-text, #1e293b);
+  text-align: left;
+  width: 100%;
+}
+
+.mcq__option:hover:not(:disabled) {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.04);
+}
+
+.mcq__option:focus {
+  outline: 2px solid var(--theme-primary, #2563eb);
+  outline-offset: 2px;
+}
+
+.mcq__option--selected {
+  border-color: var(--theme-primary, #2563eb);
+  background: rgba(37, 99, 235, 0.08);
+}
+
+.mcq__option--correct {
+  border-color: var(--theme-success, #22c55e);
+  background: rgba(34, 197, 94, 0.08);
+  color: var(--theme-text, #1e293b);
+}
+
+.mcq__option--incorrect {
+  border-color: var(--theme-error, #ef4444);
+  background: rgba(239, 68, 68, 0.08);
+  color: var(--theme-text, #1e293b);
+}
+
+.mcq__option:disabled {
+  cursor: not-allowed;
+  opacity: 0.9;
+}
+
+.mcq__option-indicator {
+  flex-shrink: 0;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  width: 20px;
+  height: 20px;
+}
+
+.mcq__option-indicator .icon-correct {
+  color: var(--theme-success, #22c55e);
+}
+
+.mcq__option-indicator .icon-incorrect {
+  color: var(--theme-error, #ef4444);
+}
+
+.mcq__option-text {
+  flex: 1;
+  line-height: 1.5;
+}
+
+.mcq__actions {
+  display: flex;
+  gap: 12px;
+  margin-top: 20px;
+}
+
+.mcq__explanation {
+  margin-top: 16px;
+  padding: 12px 16px;
+  background: var(--theme-surface, #f8fafc);
+  border-left: 4px solid var(--theme-info, #3b82f6);
+  border-radius: 4px;
+  font-size: 14px;
+  color: var(--theme-text, #1e293b);
+  line-height: 1.6;
+}
+
+.mcq__explanation strong {
+  color: var(--theme-text, #1e293b);
+  font-weight: 600;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Editor Mode
+ * ═══════════════════════════════════════════════════════════════ */
+
+.mcq-editor {
+  width: 100%;
+}
+
+.mcq-editor__option-row {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 8px;
+}
+
+.mcq-editor__option-row input[type="radio"] {
+  flex-shrink: 0;
+  width: 18px;
+  height: 18px;
+  cursor: pointer;
+}
+
+.mcq-editor__option-row input[type="text"] {
+  flex: 1;
+}
+
+.mcq-editor__option-row button {
+  flex-shrink: 0;
+}
+
+/* ═══════════════════════════════════════════════════════════════
+ * Responsive Design
+ * ═══════════════════════════════════════════════════════════════ */
+
+@media (max-width: 768px) {
+  .mcq__question {
+    font-size: 15px;
+  }
+
+  .mcq__option {
+    padding: 10px 14px;
+    font-size: 14px;
+  }
+
+  .mcq__actions {
+    flex-direction: column;
+  }
+
+  .mcq__actions button {
+    width: 100%;
+  }
+}
