+  it('calls onComplete after all tabs are visited', () => {
+    const onComplete = jest.fn();
+
+    render(
+      <TabsPreview
+        componentId="cmp-tabs"
+        componentType="tabs"
+        data={tabsData}
+        onComplete={onComplete}
+      />
