+.tpl-text-media {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  gap: 12px;
+  align-items: start;
+}
+
+/* Left/Right placements use two-column grid */
+.tpl-text-media--left {
+  grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
+}
+
+.tpl-text-media--left .tpl-text-media__media {
+  order: 0;
+}
+
+.tpl-text-media--left .tpl-text-media__text {
+  order: 1;
+}
+
+.tpl-text-media--right {
+  grid-template-columns: minmax(0, 1fr) minmax(0, 320px);
+}
+
+/* Top/Bottom placements use single-column grid */
+.tpl-text-media--top {
+  grid-template-columns: minmax(0, 1fr);
+  row-gap: 8px;
+}
+
+.tpl-text-media--top .tpl-text-media__media {
+  order: 0;
+}
+
+.tpl-text-media--top .tpl-text-media__text {
+  order: 1;
+}
+
+.tpl-text-media--bottom {
+  grid-template-columns: minmax(0, 1fr);
+  row-gap: 8px;
+}
+
+.tpl-text-media--bottom .tpl-text-media__text {
+  order: 0;
+}
+
+.tpl-text-media--bottom .tpl-text-media__media {
+  order: 1;
+}
+
+.tpl-text-media__title {
+  margin: 0 0 10px;
+  color: var(--theme-text, #1e293b);
+  font-size: 18px;
+  font-weight: 600;
