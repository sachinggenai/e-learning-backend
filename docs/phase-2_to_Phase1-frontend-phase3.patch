+**Lucide Icons to Import:**
+```typescript
+import {
+  FileText,    // for pdf, doc
+  Link,        // for link
+  Video,       // for video
+  Image,       // for image
+  Paperclip,   // for other
+  Download     // optional: for overall section icon
+} from 'lucide-react';
+```
+
+**Usage in Component:**
+```typescript
+const getResourceIcon = (type: Resource['type']) => {
+  const iconMap = {
+    pdf: FileText,
+    doc: FileText,
+    link: Link,
+    video: Video,
+    image: Image,
+    other: Paperclip,
+  };
+  const IconComponent = iconMap[type] || Paperclip;
+  return <IconComponent size={28} />;
+};
+```
