+
+.tpl-text-media__body {
+  color: var(--theme-text-secondary, #475569);
+  line-height: 1.65;
+}
+
+.tpl-text-media__body p {
+  margin: 0 0 10px;
+}
+
+.tpl-text-media__media {
+  border: 1px solid var(--theme-border, #e2e8f0);
+  border-radius: 8px;
+  background: var(--theme-background, #fff);
+  overflow: hidden;
