        },
        {
          "componentId": "c2-01-02",
          "componentType": "pre-assessment",
          "order": 1,
          "data": {
            "title": "How much do you know?",
            "instructions": "Take this quick pre-assessment so we can customize your learning path.",
            "questions": [
              {
                "id": "pre-q1",
                "question": "What does empathy mean in customer service?",
                "options": [
                  {
                    "id": "a",
                    "text": "Understanding the customer's feelings",
                    "isCorrect": true
                  },
                  {
                    "id": "b",
                    "text": "Giving refunds immediately",
                    "isCorrect": false
                  }
                ],
                "maxScore": 10
              },
              {
                "id": "pre-q2",
                "question": "The HEART framework stands for...",
                "options": [
                  {
                    "id": "a",
                    "text": "Hear, Empathize, Apologize, Resolve, Thank",
                    "isCorrect": true
                  },
                  {
                    "id": "b",
                    "text": "Help, Explain, Ask, Recite, Tell",
                    "isCorrect": false
                  }
                ],
                "maxScore": 10
              }
            ],
            "skipIfPassed": true,
