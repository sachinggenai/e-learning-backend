# Local Development Environment Configuration
# PostgreSQL with pgvector for full AI backend support

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ============================================
# AI Authoring (enabled for local development)
# ============================================
AI_AUTHORING_ENABLED=true
AI_GENERATION_PROVIDER=anthropic

# ── DeepSeek API (Anthropic-compatible endpoint) ──────────────
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=sk-e9de8e41a745480f861f03c97ef5dae7
AI_PRIMARY_MODEL=deepseek-v4-pro[1m]
AI_FALLBACK_MODEL=deepseek-v4-flash
AI_MAX_ACTIVE_SESSIONS=50
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# ============================================
# Database Configuration (PostgreSQL + pgvector)
# ============================================
DATABASE_URL=postgresql+asyncpg://elearning:elearning_secret@localhost:5432/elearning_db
DATABASE_URL_SYNC=postgresql://elearning:elearning_secret@localhost:5432/elearning_db
POSTGRES_PORT=5432

# ============================================
# Infrastructure Services (via Docker)
# ============================================
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=elearning-assets
FEATURE_DURABLE_WORKFLOW_ENGINE=true
FEATURE_SIMILAR_COURSE_RETRIEVAL=true

# ============================================
# CORS Settings
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ============================================
# Migration Settings
# ============================================
AUTO_MIGRATE=true
AUTH_MOCK_MODE=enabled

# ============================================
# Logging
# ============================================
SQL_ECHO=false
