# Environment Configuration Example
# Copy this file to .env and update values for local development

# ============================================
# Application Settings
# ============================================
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
# Option 1: Use component variables (recommended)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=elearning

# Option 2: Use full DATABASE_URL (alternative)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/elearning

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
SQL_ECHO=false

# ============================================
# CORS Settings
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ============================================
# Migration Settings
# ============================================
# Auto-run Alembic migrations on startup
AUTO_MIGRATE=false

# ============================================
# Export Features
# ============================================
# Enable export headers (X-Course-Hash, X-Export-Warnings)
EXPORT_HEADERS=0

# ============================================
# Production Server Settings (for gunicorn)
# ============================================
# Number of worker processes
WORKERS=4

# Request timeout in seconds
TIMEOUT=120

# Logging level (debug, info, warning, error, critical)
LOG_LEVEL=info

# ============================================
# Optional: Monitoring & Observability
# ============================================
# Sentry DSN for error tracking (production)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================
# Optional: Feature Flags
# ============================================
# Enable/disable specific features
# FEATURE_ENHANCED_TEMPLATES=true
# FEATURE_MEDIA_UPLOAD=true

# ============================================
# AI Authoring Configuration
# ============================================
# Master switch for all AI authoring features
# AI_AUTHORING_ENABLED=false

# AI API Provider Key
# ANTHROPIC_API_KEY=sk-ant-...

# Model routing
# AI_PRIMARY_MODEL=claude-sonnet-4-20250514
# AI_FALLBACK_MODEL=claude-haiku-4-20250514

# Token budgets
# AI_MAX_INPUT_TOKENS=8000
# AI_MAX_OUTPUT_TOKENS=4096
# AI_TOTAL_TOKEN_BUDGET=12000

# Retry and timeout
# AI_MAX_RETRIES=1
# AI_REQUEST_TIMEOUT_SECONDS=30

# Rate limits
# AI_RATE_LIMIT_CALLS_PER_HOUR=100
# AI_RATE_LIMIT_CALLS_PER_DAY=500

# Cost control
# AI_MONTHLY_COST_CAP_USD=500.0

# Safety
# AI_PROMPT_SAFETY_ENABLED=true
# AI_OUTPUT_SAFETY_ENABLED=true

# ── Session Lifecycle (US-BKND-AI-006) ───────────────────
# Session TTL in hours from creation (default: 24)
# AI_SESSION_TTL_HOURS=24

# Max concurrent active sessions per user (default: 5)
# AI_MAX_ACTIVE_SESSIONS=5

# Stale session cleanup interval in minutes (default: 15)
# AI_SESSION_CLEANUP_INTERVAL_MINUTES=15

# Max session creation requests per user per hour (default: 20)
# AI_RATE_LIMIT_CREATE_SESSION_PER_HOUR=20

# ── Persistence TTLs (US-BKND-AI-004) ────────────────────
# AI_PROPOSAL_TTL_MINUTES=60
# AI_CONFIRMATION_TTL_MINUTES=10
# AI_IDEMPOTENCY_TTL_HOURS=24
# AI_OUTBOX_POLL_INTERVAL_SECONDS=5
# AI_OUTBOX_RETRY_MAX=3

# ── Confirmation Token System (US-BKND-AI-049) ────────────
# Default TTL for confirmation tokens in minutes
# AI_CONFIRMATION_TOKEN_TTL_MINUTES=15

# Per-operation-type TTL overrides (comma-separated key=value)
# Format: operation_type=minutes,operation_type=minutes
# AI_CONFIRMATION_TOKEN_TTL_OVERRIDES=delete_course=5,course_archive=5

# Admin confirmation bypass feature flag
# AI_ADMIN_CONFIRMATION_BYPASS_ENABLED=false

# Max admin overrides per hour (rate limit)
# AI_ADMIN_OVERRIDE_RATE_LIMIT_PER_HOUR=5

# Security event logging level for token mismatches
# AI_CONFIRMATION_SECURITY_LOG_LEVEL=ERROR

# ── Context Window (US-BKND-AI-028) ────────────────────
# Max tokens for the LLM context window
# AI_MAX_CONTEXT_TOKENS=8000

# Tokens reserved for the model's response
# AI_RESERVE_OUTPUT_TOKENS=4096

# Pruning strategy: sliding_window, priority, or summarize
# AI_CONTEXT_PRUNING_STRATEGY=sliding_window

# Minimum messages to keep regardless of token count
# AI_MIN_KEEP_MESSAGES=2

# ── Safety Guardrails (US-BKND-AI-025) ─────────────────
# PII redaction mode: reject, redact, or mask
# AI_PII_REDACTION_MODE=redact

# Comma-separated list of blocked output terms
# AI_BLOCKED_TERMS_LIST=hate speech,violence,self-harm,suicide method,child exploitation,terrorism,weapon manufacture

# Scan IP addresses as PII (default: false)
# AI_PII_SCAN_IPS=false

# Mock mode — MUST be disabled in production!
# AUTH_MOCK_MODE=enabled

# ── Similar Course Retrieval / Advanced RAG (US-BKND-AI-015) ──
# Feature gate — must be "true" to enable the retrieval engine
# FEATURE_SIMILAR_COURSE_RETRIEVAL=true

# Embedding provider: "mock" (deterministic, zero-cost) or "openai" (production)
# EMBEDDING_PROVIDER=mock

# OpenAI API key — required only when EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# Embedding model name (only relevant for openai provider)
# EMBEDDING_MODEL=text-embedding-ada-002

# Vector dimension — must match the configured model's output
# EMBEDDING_DIMENSION=1536

# Enable pgvector extension for Tier-1 vector search (requires pgvector installed)
# ENABLE_PGVECTOR=false

# Maximum results returned per query (hard cap — requests exceeding this are clamped)
# SIMILAR_COURSE_MAX_RESULTS=20

# Similarity cache TTL in minutes (future — cache table not used in MVP)
# SIMILAR_COURSE_CACHE_TTL_MINUTES=60
